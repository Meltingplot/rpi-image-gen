# Meltingplot device identity - commissioning file
#
# Copy this file to the BOOTCONFIG partition of a freshly flashed medium as
#   meltingplot/identity.conf
# The BOOTCONFIG partition is the first partition of the image (FAT, label
# BOOTCONFIG, mounted read-write as /bootfs on the running device). It already
# holds autoboot.txt.
#
# The first boot reads this file, stores the values on the persistent partition
# and removes the auth key from here. Once a device carries an identity, the
# serial cannot be changed from this file; only a new auth key is still
# applied. Lines starting with # are comments, whitespace around = is ignored.

# Meltingplot serial number of the CHX350. Required.
# Exactly three digits, as printed on the machine.
printer_serial=042

# Display name shown by Duet Web Control and PanelDue (M550), and the source of
# the Linux hostname. Optional - defaults to meltingplot-chx-350-<serial>-sbc.
# Allowed: ASCII letters, digits, space and '-', at most 40 characters (limit
# imposed by DuetControlServer). The customer can change this later in DWC or
# with `sudo mp-set-printer-name "<name>"`.
#printer_name=Halle 2 links

# Single-use Raspberry Pi Connect auth key for this device, taken from the
# Connect dashboard or created with the organisations management API. Optional.
# The device signs in automatically on first boot, then this line is replaced
# with the date it was applied so the secret does not stay on the FAT
# partition.
#connect_authkey=rpoak_XXXXXXXXXXXXXXXX
