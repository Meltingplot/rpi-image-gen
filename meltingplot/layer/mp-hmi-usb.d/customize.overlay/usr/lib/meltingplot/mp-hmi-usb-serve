#!/usr/bin/python3
"""Hand the USB sticks at the operator panel to the printer's interface.

mp-hmi-usb-mount mounts every stick read-only under /run/mp-hmi-usb/<name>/fs.
This lists their folders and G-code files and hands such a file out, on the
loopback for mp-hmi-proxy, which passes /hmi/usb/ on to the panel's own
browser only. The job list of the CHX 350 interface shows a stick as a folder
and copies a job from it to the printer.

  GET /list               the sticks: {"sticks": [{"name", "label"}]}
  GET /list?path=<path>   a folder on a stick, <path> = <name>[/<folder>...]:
                          {"entries": [{"name", "type": "dir"},
                                       {"name", "type": "file", "size", "mtime"}]}
  GET /file?path=<path>   a G-code file on a stick

Nothing outside a stick is reachable: a path is a stick and the names on it,
no "." or "..", and no symbolic link anywhere on the way. Hidden entries (a
leading dot: macOS writes a ._ file beside every job) are neither listed nor
handed out.
"""
import http.server
import json
import os
import shutil
import stat
import urllib.parse

ROOT = os.environ.get("MP_USB_DIR", "/run/mp-hmi-usb")
PORT = int(os.environ.get("MP_USB_PORT", "8083"))

# The job files the printer's interface lists (Path.isGCodePath in DWC)
GCODE = (".g", ".gcode", ".gc", ".gco", ".nc", ".ngc", ".tap")
# What Windows keeps on every stick
SYSTEM_DIRS = ("system volume information", "$recycle.bin")


class NotFound(Exception):
    pass


def is_gcode(name):
    return name.lower().endswith(GCODE)


def visible(name):
    """Neither hidden nor a name the browser cannot send back (not UTF-8)"""
    if name.startswith("."):
        return False
    try:
        name.encode("utf-8")
    except UnicodeEncodeError:
        return False
    return True


def sticks():
    try:
        names = sorted(os.listdir(ROOT))
    except FileNotFoundError:
        return []
    result = []
    for name in names:
        # the label is there while the stick is mounted
        try:
            with open(os.path.join(ROOT, name, "label"), encoding="utf-8", errors="replace") as f:
                label = f.read().strip()
        except OSError:
            continue
        result.append({"name": name, "label": label})
    return result


def resolve(path):
    """Absolute path of <name>[/<entry>...] on a mounted stick"""
    parts = path.split("/")
    if any(p in ("", ".", "..") or not visible(p) or "\0" in p for p in parts):
        raise NotFound
    if not os.path.exists(os.path.join(ROOT, parts[0], "label")):
        raise NotFound
    base = os.path.realpath(os.path.join(ROOT, parts[0], "fs"))
    full = os.path.join(base, *parts[1:])
    if os.path.realpath(full) != full:
        raise NotFound
    return full


def listing(path):
    entries = []
    with os.scandir(resolve(path)) as it:
        for entry in it:
            if not visible(entry.name):
                continue
            try:
                st = entry.stat(follow_symlinks=False)
            except OSError:
                continue
            if stat.S_ISDIR(st.st_mode):
                if entry.name.lower() not in SYSTEM_DIRS:
                    entries.append({"name": entry.name, "type": "dir"})
            elif stat.S_ISREG(st.st_mode) and is_gcode(entry.name):
                entries.append({"name": entry.name, "type": "file",
                                "size": st.st_size, "mtime": int(st.st_mtime)})
    entries.sort(key=lambda e: e["name"].lower())
    return entries


class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        url = urllib.parse.urlsplit(self.path)
        query = urllib.parse.parse_qs(url.query, keep_blank_values=True)
        path = query.get("path", [""])[0]
        try:
            if url.path == "/list":
                self.send_json({"sticks": sticks()} if path == "" else {"entries": listing(path)})
            elif url.path == "/file":
                self.send_file(path)
            else:
                raise NotFound
        except (NotFound, FileNotFoundError, NotADirectoryError):
            self.send_json({"error": "not found"}, 404)
        except OSError as e:
            # the stick went while it was read
            self.log_error("%s: %s", path, e)
            self.send_json({"error": "unreadable"}, 500)

    def send_json(self, body, code=200):
        data = json.dumps(body).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def send_file(self, path):
        full = resolve(path)
        if not is_gcode(full):
            raise NotFound
        with open(full, "rb") as f:
            st = os.fstat(f.fileno())
            if not stat.S_ISREG(st.st_mode):
                raise NotFound
            self.send_response(200)
            self.send_header("Content-Type", "application/octet-stream")
            self.send_header("Content-Length", str(st.st_size))
            self.send_header("Last-Modified", self.date_time_string(st.st_mtime))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            try:
                shutil.copyfileobj(f, self.wfile, 1 << 20)
            except OSError as e:
                # pulled mid-file, or the browser went: the length tells it
                # the file is short, nothing more can be said
                self.log_error("%s: %s", path, e)
                self.close_connection = True

    # The interface asks every few seconds whether a stick is in; only
    # failures are worth the journal
    def log_request(self, code="-", size="-"):
        if isinstance(code, int) and code >= 400:
            super().log_request(code, size)


http.server.ThreadingHTTPServer(("127.0.0.1", PORT), Handler).serve_forever()
