[Unit]
Description=Switch the panel's web front to the update page while an update installs
RequiresMountsFor=/bootfs
# No ordering against haproxy: this restarts haproxy and waits for it, and
# haproxy waiting for this in turn left both stuck (bench, 2026-10-10).

[Service]
Type=oneshot
ExecStart=/usr/sbin/mp-hmi-ota-state
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
