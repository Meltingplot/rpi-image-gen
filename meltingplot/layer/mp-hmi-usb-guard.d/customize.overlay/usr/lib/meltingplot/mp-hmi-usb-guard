#!/bin/sh
# Decide whether a USB interface at the panel gets a driver:
#
#   mp-hmi-usb-guard <interface>        e.g. 1-2:1.0
#
# run by udev for every new interface (50-mp-hmi-usb-guard.rules), which
# comes up without a driver. Allowed are
#
#   the camera   on its port (MP_USB_CAMERA_PORT), the Meltingplot
#                rpi-camera with nothing but CDC networking
#   a USB stick  one interface and nothing else: mass storage, SCSI,
#                bulk-only or UAS
#
# Everything else stays without a driver and is logged: a keyboard, a mouse,
# a network adapter, a hub, a stick that also claims to be a keyboard. An
# interface bound before udev ran (a boot without usbcore.authorized_default
# =0) loses its driver. All interfaces of an allowed device are authorized
# before any is probed: the kernel refuses a driver the claim of a second
# interface (cdc_ncm its data interface) that is not authorized yet.

set -eu

MP_SYSFS=${MP_SYSFS:-/sys}
MP_USB_GUARD_CONF=${MP_USB_GUARD_CONF:-/etc/meltingplot/usb-guard.conf}
MP_USB_CAMERA_PORT=1-1
# shellcheck source=/dev/null
[ ! -r "$MP_USB_GUARD_CONF" ] || . "$MP_USB_GUARD_CONF"

intf=${1:-}
case $intf in
   */*) echo "mp-hmi-usb-guard: no USB interface: $intf" >&2; exit 2 ;;
   # a root hub's own hub interface (1-0:1.0), bound before udev ran: the
   # whole bus hangs on it
   *-0:*) exit 0 ;;
   [0-9]*-[0-9]*:*) ;;
   *) echo "mp-hmi-usb-guard: no USB interface: $intf" >&2; exit 2 ;;
esac
dev=${intf%%:*}
usb=$MP_SYSFS/bus/usb
d=$usb/devices/$dev

# An attribute without the padding the kernel puts in front of numbers
attr() {
   v=$(cat "$1/$2" 2>/dev/null) || v=
   echo "${v# }"
}

interfaces() {
   for i in "$d":*; do
      [ ! -e "$i" ] || echo "${i##*/}"
   done
}

class() {
   echo "$(attr "$usb/devices/$1" bInterfaceClass)/$(attr "$usb/devices/$1" bInterfaceSubClass)/$(attr "$usb/devices/$1" bInterfaceProtocol)"
}

is_camera() {
   [ "$dev" = "$MP_USB_CAMERA_PORT" ] &&
   [ "$(attr "$d" manufacturer)" = meltingplot ] &&
   [ "$(attr "$d" product)" = "Pi Cam" ] || return 1
   for i in $(interfaces); do
      case $(class "$i") in
         02/*|0a/*) ;;
         *) return 1 ;;
      esac
   done
}

is_stick() {
   [ "$(attr "$d" bNumInterfaces)" = 1 ] || return 1
   case $(class "$intf") in
      08/06/50|08/06/62) ;;
      *) return 1 ;;
   esac
}

if is_camera || is_stick; then
   for i in $(interfaces); do
      [ "$(attr "$usb/devices/$i" authorized)" = 1 ] || echo 1 > "$usb/devices/$i/authorized"
   done
   for i in $(interfaces); do
      echo "$i" > "$usb/drivers_probe" ||
         logger -t mp-hmi-usb-guard "no driver took $i"
   done
else
   [ "$(attr "$usb/devices/$intf" authorized)" = 0 ] || echo 0 > "$usb/devices/$intf/authorized"
   logger -t mp-hmi-usb-guard "refused $intf: $(attr "$d" idVendor):$(attr "$d" idProduct)" \
      "'$(attr "$d" manufacturer)' '$(attr "$d" product)', interface $(class "$intf")," \
      "$(attr "$d" bNumInterfaces) interface(s): only the camera and a plain USB stick get a driver"
fi
