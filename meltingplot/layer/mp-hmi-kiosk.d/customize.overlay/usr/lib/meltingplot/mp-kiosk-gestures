#!/bin/sh
# Swipes on the touch screen for the panel at the top edge.
#
# lisgd reads the touch screen directly, which 71-mp-kiosk-touch.rules opens
# to the session on the seat. It takes the screen's geometry from Wayland,
# its rotation included, so edges and directions are those the operator sees
# however the display is mounted: turning them again by the configured
# rotation put the swipe at the bottom edge of an upside-down CHX350 display
# (bench, 2026-10-10).

set -u

dev=/dev/input/mp-touchscreen
panel=/usr/lib/meltingplot/mp-kiosk-panel

if [ ! -e "$dev" ]; then
   echo "mp-kiosk-gestures: no touch screen at $dev" >&2
   exit 0
fi

# down from the top edge shows the panel; up anywhere puts it away again,
# which is also what scrolling a page down does
exec lisgd -d "$dev" \
   -g "1,UD,T,*,R,$panel show" \
   -g "1,DU,*,*,R,$panel hide"
