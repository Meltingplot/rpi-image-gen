#!/bin/sh
# Write the A/B image this card carries to the NVMe drive, with nobody at the
# machine, and make the bootloader start from the drive.
#
#   1. find exactly one NVMe drive, empty unless installer.conf releases it
#   2. check identity.conf on the card and the image on the card
#   3. write the image, read it back and compare
#   4. hand identity.conf to the drive's BOOTCONFIG and reset the card's copy
#   5. update the bootloader and set it to start from NVMe first
#   6. restart, into the drive
#
# Nothing is written before every check of steps 1 and 2 has passed. Each
# step is logged to meltingplot/installer.log on the card. A failure leaves
# the green LED blinking a code (see mp-installer.sh) until power is removed.

set -eu

MP_TAG=mp-installer
. /usr/lib/meltingplot/mp-common.sh
. /usr/lib/meltingplot/mp-installer.sh

WORK=/run/mp-installer
MNT=$WORK/bootconfig

fail() {
   trap - EXIT
   mpi_log "STOPPED (code $1): $2"
   mountpoint -q "$MNT" 2>/dev/null && umount "$MNT" 2>/dev/null || true
   mpi_blink_forever "$1"
}

trap 'fail "$MPI_E_FAILED" "unexpected error, see the lines above"' EXIT

mpi_led busy
mpi_load_conf
install -d -m 0700 "$WORK" "$MNT"

mpi_log "installer for $MPI_IMAGE, card version ${MPI_VERSION:-unknown}"

# --- 1. the drive -----------------------------------------------------------

# The drive may enumerate after this unit starts.
dev=
i=0
while [ "$i" -lt 30 ]; do
   dev=$(mpi_target) && break
   dev=
   sleep 1
   i=$((i + 1))
done
if [ -z "$dev" ]; then
   n=$(mpi_nvme_disks | wc -l)
   [ "$n" -eq 0 ] && fail "$MPI_E_NODRIVE" "no NVMe drive found"
   fail "$MPI_E_NODRIVE" "$n NVMe drives found, expected one: $(mpi_nvme_disks | tr '\n' ' ')"
fi

root_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null || true)
[ "$(basename "$dev")" != "$root_disk" ] ||
   fail "$MPI_E_FAILED" "$dev is the disk this card runs from"

serial=$(mpi_drive_serial "$dev")
size=$(blockdev --getsize64 "$dev")
mpi_log "drive $dev: $(mpi_drive_model "$dev"), serial ${serial:-unknown}, $size bytes"
[ "$size" -ge "$MPI_RAW_SIZE" ] ||
   fail "$MPI_E_FAILED" "$dev holds $size bytes, the image needs $MPI_RAW_SIZE"

overwrite=n
mpi_card_flag "$MPI_CARD/installer.conf" overwrite_nvme && overwrite=y

if ! mpi_drive_blank "$dev"; then
   if [ "$overwrite" = y ]; then
      mpi_log "$dev is not empty; installer.conf releases it, it will be overwritten"
   elif [ -n "$serial" ] && [ "$(mpi_state_get serial)" = "$serial" ] &&
        [ "$(mpi_state_get image)" = "$MPI_IMAGE" ]; then
      # This card installed this drive. Either the bootloader step did not
      # finish, then finish it, or the Pi did not start from the drive.
      if [ "$(mpi_state_get bootloader)" = pending ]; then
         mpi_log "$dev already holds $MPI_IMAGE from this card; completing the bootloader step"
         resume=y
      else
         fail "$MPI_E_NOBOOT" "$dev already holds $MPI_IMAGE from this card, but the Pi started from the SD card again; the bootloader does not start this drive"
      fi
   else
      fail "$MPI_E_NOTEMPTY" "$dev is not empty ($(wipefs --no-act --noheadings --output TYPE "$dev" 2>/dev/null | tr '\n' ' ')); set overwrite_nvme=yes in meltingplot/installer.conf to overwrite it"
   fi
fi
resume=${resume:-n}

# --- 2. the card --------------------------------------------------------------

if [ "$resume" = n ]; then
   problem=$(mpi_identity_problem "$MPI_CARD/identity.conf")
   [ -z "$problem" ] || fail "$MPI_E_CONFIG" "meltingplot/identity.conf: $problem"
   if mpi_identity_set "$MPI_CARD/identity.conf"; then
      mpi_log "identity.conf: serial $(mp_conf_get "$MPI_CARD/identity.conf" printer_serial)"
   else
      mpi_log "identity.conf is not filled in; the device will start unprovisioned"
   fi

   mpi_log "checking $MPI_PAYLOAD"
   [ "$(sha256sum "$MPI_PAYLOAD" | cut -d' ' -f1)" = "$MPI_SHA256" ] ||
      fail "$MPI_E_FAILED" "the image on this card is damaged (checksum differs); write the card again"

# --- 3. write and compare -----------------------------------------------------

   if [ "$overwrite" = y ]; then
      # Takes the old partition table and its backup at the end of the drive
      # with it, so nothing of the previous installation is read as current.
      wipefs --all --force "$dev" >/dev/null
   fi
   # The previous run on this card may have left a state for this drive.
   rm -f "$MPI_CARD/installer.state"

   mpi_log "writing $MPI_IMAGE to $dev"
   rm -f "$WORK/pipe.err"
   { zstd -dc --no-progress "$MPI_PAYLOAD" || echo zstd > "$WORK/pipe.err"; } |
      { dd of="$dev" bs=4M iflag=fullblock conv=fsync status=none || echo dd >> "$WORK/pipe.err"; }
   [ ! -s "$WORK/pipe.err" ] ||
      fail "$MPI_E_FAILED" "writing $dev failed in $(tr '\n' ' ' < "$WORK/pipe.err")"

   mpi_log "reading $dev back"
   sync
   echo 3 > /proc/sys/vm/drop_caches
   blockdev --flushbufs "$dev"
   [ "$(head -c "$MPI_RAW_SIZE" "$dev" | sha256sum | cut -d' ' -f1)" = "$MPI_RAW_SHA256" ] ||
      fail "$MPI_E_FAILED" "$dev does not read back what was written; the drive may be faulty"
   mpi_log "$dev holds $MPI_IMAGE, verified"

# --- 4. identity --------------------------------------------------------------

   blockdev --rereadpt "$dev"
   udevadm settle
   part=${dev}p1
   [ "$(blkid -o value -s LABEL "$part" 2>/dev/null)" = BOOTCONFIG ] ||
      fail "$MPI_E_FAILED" "$part is not the BOOTCONFIG partition of the image"
   mount -t vfat "$part" "$MNT"
   install -d "$MNT/meltingplot"
   if mpi_identity_set "$MPI_CARD/identity.conf"; then
      cp "$MPI_CARD/identity.conf" "$MNT/meltingplot/identity.conf"
      sync
      cmp -s "$MPI_CARD/identity.conf" "$MNT/meltingplot/identity.conf" ||
         fail "$MPI_E_FAILED" "identity.conf did not arrive on $part"
      mpi_log "identity.conf handed to the drive"
   fi
   {
      echo "# Written by mp-installer when this drive was installed."
      echo "image=$MPI_IMAGE"
      echo "sha256=$MPI_RAW_SHA256"
      echo "installer=${MPI_VERSION:-unknown}"
      echo "drive=$(mpi_drive_model "$dev") $serial"
      echo "bootloader_before=$(mpi_bootloader_date)"
      echo "installed=$(date -u +%Y-%m-%dT%H:%M:%SZ) (the Pi's clock, not synchronised)"
   } > "$MNT/meltingplot/installer.txt"
   sync
   umount "$MNT"

   # The secret and the serial belong to this device only. The card goes back
   # to its delivered state, ready to be filled in for the next one.
   if mpi_identity_set "$MPI_CARD/identity.conf"; then
      cp "$MPI_IDENTITY_TEMPLATE" "$MPI_CARD/identity.conf"
      mpi_log "identity.conf on the card reset"
   fi
   [ "$overwrite" = n ] || mpi_card_spend "$MPI_CARD/installer.conf" overwrite_nvme "used $(date -u +%Y-%m-%d)"
   mpi_state_write "$MPI_IMAGE" "$serial" pending
fi

# --- 5. bootloader --------------------------------------------------------------

image=$(rpi-eeprom-update -l) || fail "$MPI_E_FAILED" "no bootloader image found"
want=$(mpi_eeprom_image_date "$image")
have=$(mpi_bootloader_date)
rpi-eeprom-config --out "$WORK/current.conf" >/dev/null ||
   fail "$MPI_E_FAILED" "cannot read the bootloader configuration"
mpi_eeprom_conf "$WORK/current.conf" "$MPI_BOOT_ORDER" "${MPI_PSU_MAX_CURRENT:-}" "${MPI_PCIE_PROBE:-n}" > "$WORK/boot.conf"

if [ "$have" = "$want" ] && cmp -s "$WORK/current.conf" "$WORK/boot.conf"; then
   mpi_log "bootloader $have already configured"
else
   mpi_log "bootloader ${have:-unknown} -> $want, configuration: $(grep -v '^\[' "$WORK/boot.conf" | tr '\n' ' ')"
   # The card installs the bootloader it was built with, also over a newer
   # one, so every device it commissions runs a known version. A board that
   # needs a newer one than that is still refused by rpi-eeprom-update.
   RPI_EEPROM_ALLOW_DOWNGRADE=1 rpi-eeprom-config --apply "$WORK/boot.conf" "$image" >> "$MPI_CARD/installer.log" 2>&1 ||
      fail "$MPI_E_FAILED" "updating the bootloader failed"
fi
mpi_state_write "$MPI_IMAGE" "$serial" "$want"

# --- 6. restart -----------------------------------------------------------------

mpi_log "done; restarting into $dev"
trap - EXIT
mpi_led on
sync
systemctl reboot
