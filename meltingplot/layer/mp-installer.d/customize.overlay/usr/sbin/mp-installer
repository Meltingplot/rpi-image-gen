#!/bin/sh
# Write the A/B image this card carries to the NVMe drive, with nobody at the
# machine, and make the bootloader start from the drive.
#
#   1. find exactly one NVMe drive of at least the size installer.conf names,
#      empty unless installer.conf releases it, and tell which layout it holds
#      (gen1 to gen4, docs/meltingplot-layout.md)
#   2. check identity.conf on the card and the image on the card
#   3. write the image, read it back and compare; never the reserve, which is
#      discarded instead, and on a drive of the image's own layout not its
#      audit partition either, which stays as it is
#   4. hand identity.conf to the drive's BOOTCONFIG and reset the card's copy
#   5. update the bootloader and set it to start from NVMe first
#   6. restart, into the drive
#
# Nothing is written before every check of steps 1 and 2 has passed. Each
# step is logged to meltingplot/installer.log on the card. While the card
# works the green LED flickers; a failure turns the red LED on and leaves the
# green one blinking a code (see mp-installer.sh) until power is removed. A
# start after an interruption, such as power taken away, picks the card's own
# work on that drive up again.

set -eu

MP_TAG=mp-installer
. /usr/lib/meltingplot/mp-common.sh
. /usr/lib/meltingplot/mp-installer.sh

WORK=/run/mp-installer
MNT=$WORK/bootconfig

fail() {
   trap - EXIT
   mpi_log "STOPPED (code $1): $2"
   mountpoint -q "$MNT" 2>/dev/null && umount "$MNT" 2>/dev/null || true
   mpi_blink_forever "$1"
}

trap 'fail "$MPI_E_FAILED" "unexpected error, see the lines above"' EXIT

mpi_led busy
mpi_load_conf
install -d -m 0700 "$WORK" "$MNT"

mpi_log "installer for $MPI_IMAGE, card version ${MPI_VERSION:-unknown}"

# --- 1. the drive -----------------------------------------------------------

# The drive may enumerate after this unit starts.
dev=
i=0
while [ "$i" -lt 30 ]; do
   dev=$(mpi_target) && break
   dev=
   sleep 1
   i=$((i + 1))
done
if [ -z "$dev" ]; then
   n=$(mpi_nvme_disks | wc -l)
   [ "$n" -eq 0 ] && fail "$MPI_E_NODRIVE" "no NVMe drive found"
   fail "$MPI_E_NODRIVE" "$n NVMe drives found, expected one: $(mpi_nvme_disks | tr '\n' ' ')"
fi

root_disk=$(lsblk -no PKNAME "$(findmnt -no SOURCE /)" 2>/dev/null || true)
[ "$(basename "$dev")" != "$root_disk" ] ||
   fail "$MPI_E_FAILED" "$dev is the disk this card runs from"

serial=$(mpi_drive_serial "$dev")
size=$(blockdev --getsize64 "$dev")
mpi_log "drive $dev: $(mpi_drive_model "$dev"), serial ${serial:-unknown}, $size bytes"
[ "$size" -ge "$MPI_RAW_SIZE" ] ||
   fail "$MPI_E_FAILED" "$dev holds $size bytes, the image needs $MPI_RAW_SIZE"
# The target is an SSD of at least 128 GB (docs/meltingplot-layout.md, LY-08).
[ "$size" -ge "${MPI_MIN_DRIVE_BYTES:-0}" ] ||
   fail "$MPI_E_FAILED" "$dev holds $size bytes, less than the $MPI_MIN_DRIVE_BYTES this card writes to"

blank=n
mpi_drive_blank "$dev" && blank=y
overwrite=n
mpi_card_flag "$MPI_CARD/installer.conf" overwrite_nvme && overwrite=y

action=$(mpi_decide "$blank" "$overwrite" "$serial" "$MPI_IMAGE")
case $action in
   write) ;;
   overwrite)
      mpi_log "$dev is not empty; installer.conf releases it, it will be overwritten" ;;
   rewrite)
      mpi_log "an earlier start of this card did not finish writing $dev; writing it again" ;;
   bootloader)
      mpi_log "$dev already holds $MPI_IMAGE from this card; completing the bootloader step" ;;
   noboot)
      fail "$MPI_E_NOBOOT" "$dev already holds $MPI_IMAGE from this card, but the Pi started from the SD card again; the bootloader does not start this drive" ;;
   *)
      fail "$MPI_E_NOTEMPTY" "$dev is not empty ($(wipefs --no-act --noheadings --output TYPE "$dev" 2>/dev/null | tr '\n' ' ')); set overwrite_nvme=yes in meltingplot/installer.conf to overwrite it" ;;
esac

# What the drive held, and whether its audit partition stays as it is
# (docs/meltingplot-audit-log.md, AL-18). The card keeps it only on a drive of
# the layout its image has: gen4 when the image has a reserve (MPI_SKIP),
# gen3 otherwise. There the partition has to lie where this image puts it.
# gen1 and gen2 have no audit log; the audit partition of gen3 is 512M and
# moves to gen4 written anew (docs/meltingplot-layout.md: only the bench panel
# had gen3, with a test log). A gen4 drive whose reserve is not where the
# image puts it was changed in the field by a layout newer than this card,
# which then does not write. Once writing began the drive no longer shows
# what it held, so a start after an interruption takes both from the card's
# state.
image_layout=gen3
[ -z "${MPI_SKIP:-}" ] || image_layout=gen4
layout=blank
keep=none
case $action in
   overwrite)
      parts=$(mpi_partitions "$dev")
      skip_names=$(mpi_skip_list "${MPI_SKIP:-}" | cut -d' ' -f1 | tr '\n' ' ')
      layout=$(printf '%s\n' "$parts" | mpi_layout_generation "${MPI_KEEP_PART:-}" "$skip_names")
      if [ "$layout" = "$image_layout" ]; then
         moved=$(printf '%s\n' "$parts" | mpi_skip_moved "${MPI_SKIP:-}")
         [ -z "$moved" ] ||
            fail "$MPI_E_FAILED" "$dev has its $moved partition somewhere else than $MPI_IMAGE puts it: its layout was changed after this card was made, and this card does not write it"
         keep=$(printf '%s\n' "$parts" |
            mpi_keep_decision "$MPI_KEEP_PART" "${MPI_KEEP_START:-}" "${MPI_KEEP_SIZE:-}")
         [ "$keep" != moved ] ||
            fail "$MPI_E_FAILED" "$dev has its $MPI_KEEP_PART partition somewhere else than $MPI_IMAGE puts it; this card cannot keep that log and does not write"
      fi
      case $layout in
         gen1|gen2) mpi_log "$dev holds the A/B layout $layout, without an audit log; it moves to the layout of $MPI_IMAGE" ;;
         gen3|gen4)
            if [ "$keep" = keep ]; then
               mpi_log "$dev holds the A/B layout $layout; its $MPI_KEEP_PART partition stays as it is"
            else
               mpi_log "$dev holds the A/B layout $layout; it moves to the layout $image_layout of $MPI_IMAGE, and its $MPI_KEEP_PART partition is written anew"
            fi ;;
         *) mpi_log "$dev holds no Meltingplot A/B layout ($layout)" ;;
      esac ;;
   rewrite|bootloader)
      layout=$(mpi_state_get layout)
      layout=${layout:-unknown}
      keep=$(mpi_state_get keep)
      keep=${keep:-none} ;;
esac

# --- 2. the card --------------------------------------------------------------

if [ "$action" != bootloader ]; then
   problem=$(mpi_identity_problem "$MPI_CARD/identity.conf")
   [ -z "$problem" ] || fail "$MPI_E_CONFIG" "meltingplot/identity.conf: $problem"
   if mpi_identity_set "$MPI_CARD/identity.conf"; then
      mpi_log "identity.conf: serial $(mp_conf_get "$MPI_CARD/identity.conf" printer_serial)"
   else
      mpi_log "identity.conf is not filled in; the device will start unprovisioned"
   fi

   mpi_log "checking $MPI_PAYLOAD"
   [ "$(sha256sum "$MPI_PAYLOAD" | cut -d' ' -f1)" = "$MPI_SHA256" ] ||
      fail "$MPI_E_FAILED" "the image on this card is damaged (checksum differs); write the card again"

# --- 3. write and compare -----------------------------------------------------

   if [ "$action" != write ]; then
      # Takes the old partition table and its backup at the end of the drive
      # with it, so nothing of the previous installation is read as current.
      wipefs --all --force "$dev" >/dev/null
   fi
   # From here on the drive is no longer empty. Should the card be stopped
   # before it is done, the next start knows the drive as its own work.
   mpi_state_write "$MPI_IMAGE" "$serial" writing "" "$layout" "$keep"

   # The ranges left as the drive has them: the reserve always (LY-10), the
   # audit partition when it is kept. In blocks of 4 MiB: the build checked
   # that they are aligned to that (mp-installer-measure). The image's bytes
   # for them are read and dropped.
   if [ "$keep" = keep ]; then
      ranges=$(mpi_ranges "${MPI_SKIP:-}" "$MPI_KEEP_START" "$MPI_KEEP_SIZE")
      mpi_log "writing $MPI_IMAGE to $dev; $MPI_KEEP_PART ($MPI_KEEP_SIZE bytes from byte $MPI_KEEP_START) stays as it is"
   else
      ranges=$(mpi_ranges "${MPI_SKIP:-}")
      mpi_log "writing $MPI_IMAGE to $dev"
   fi
   [ -z "${MPI_SKIP:-}" ] || mpi_log "never written: $MPI_SKIP (name:start:size)"
   rm -f "$WORK/pipe.err"
   { zstd -dc --no-progress "$MPI_PAYLOAD" || echo zstd > "$WORK/pipe.err"; } |
      { mpi_write_skipping "$dev" "$ranges" || echo dd >> "$WORK/pipe.err"; }
   [ ! -s "$WORK/pipe.err" ] ||
      fail "$MPI_E_FAILED" "writing $dev failed in $(tr '\n' ' ' < "$WORK/pipe.err")"
   if [ -n "${MPI_SKIP:-}" ]; then
      undiscarded=$(mpi_discard_skipped "$dev" "$MPI_SKIP" | tr '\n' ' ')
      [ -z "$undiscarded" ] || mpi_log "$dev cannot discard $undiscarded; what it held there stays, unread"
   fi

   mpi_log "reading $dev back"
   sync
   echo 3 > /proc/sys/vm/drop_caches
   blockdev --flushbufs "$dev"
   read_back=$(mpi_read_back_skipping "$dev" "$MPI_RAW_SIZE" "$ranges")
   if [ "$keep" = keep ]; then
      want_back=$MPI_RAW_SHA256_KEEP
   else
      want_back=${MPI_RAW_SHA256_SKIP:-$MPI_RAW_SHA256}
   fi
   [ "$read_back" = "$want_back" ] ||
      fail "$MPI_E_FAILED" "$dev does not read back what was written; the drive may be faulty"
   mpi_log "$dev holds $MPI_IMAGE, verified"

# --- 4. identity --------------------------------------------------------------

   blockdev --rereadpt "$dev"
   udevadm settle
   part=${dev}p1
   [ "$(blkid -o value -s LABEL "$part" 2>/dev/null)" = BOOTCONFIG ] ||
      fail "$MPI_E_FAILED" "$part is not the BOOTCONFIG partition of the image"
   mount -t vfat "$part" "$MNT"
   install -d "$MNT/meltingplot"
   if mpi_identity_set "$MPI_CARD/identity.conf"; then
      cp "$MPI_CARD/identity.conf" "$MNT/meltingplot/identity.conf"
      sync
      cmp -s "$MPI_CARD/identity.conf" "$MNT/meltingplot/identity.conf" ||
         fail "$MPI_E_FAILED" "identity.conf did not arrive on $part"
      mpi_log "identity.conf handed to the drive"
   fi
   {
      echo "# Written by mp-installer when this drive was installed."
      echo "image=$MPI_IMAGE"
      echo "sha256=$MPI_RAW_SHA256"
      echo "installer=${MPI_VERSION:-unknown}"
      echo "drive=$(mpi_drive_model "$dev") $serial"
      echo "bootloader_before=$(mpi_bootloader_date)"
      echo "installed=$(date -u +%Y-%m-%dT%H:%M:%SZ) (the Pi's clock, not synchronised)"
      # For the audit log, which starts by saying why it starts here
      # (docs/meltingplot-audit-log.md, AL-18): the layout the drive held and
      # whether its audit partition was kept.
      echo "layout_before=$layout"
      echo "keep_part=${MPI_KEEP_PART:-}"
      if [ "$keep" = keep ]; then echo "kept=yes"; else echo "kept=no"; fi
   } > "$MNT/meltingplot/installer.txt"
   sync
   umount "$MNT"

   # The secret and the serial belong to this device only. The card goes back
   # to its delivered state, ready to be filled in for the next one.
   if mpi_identity_set "$MPI_CARD/identity.conf"; then
      cp "$MPI_IDENTITY_TEMPLATE" "$MPI_CARD/identity.conf"
      mpi_log "identity.conf on the card reset"
   fi
   [ "$action" != overwrite ] || mpi_card_spend "$MPI_CARD/installer.conf" overwrite_nvme "used $(date -u +%Y-%m-%d)"
   mpi_state_write "$MPI_IMAGE" "$serial" bootloader "" "$layout" "$keep"
fi

# --- 5. bootloader --------------------------------------------------------------

image=$(rpi-eeprom-update -l) || fail "$MPI_E_FAILED" "no bootloader image found"
want=$(mpi_eeprom_image_date "$image")
have=$(mpi_bootloader_date)
rpi-eeprom-config --out "$WORK/current.conf" >/dev/null ||
   fail "$MPI_E_FAILED" "cannot read the bootloader configuration"
mpi_eeprom_conf "$WORK/current.conf" "$MPI_BOOT_ORDER" "${MPI_PSU_MAX_CURRENT:-}" "${MPI_PCIE_PROBE:-n}" > "$WORK/boot.conf"

if [ "$have" = "$want" ] && cmp -s "$WORK/current.conf" "$WORK/boot.conf"; then
   mpi_log "bootloader $have already configured"
else
   mpi_log "bootloader ${have:-unknown} -> $want, configuration: $(grep -v '^\[' "$WORK/boot.conf" | tr '\n' ' ')"
   # A power cut while the EEPROM is written can leave a Pi that no longer
   # starts at all; the steady LED says to keep the power on.
   mpi_led steady
   # The card installs the bootloader it was built with, also over a newer
   # one, so every device it commissions runs a known version. A board that
   # needs a newer one than that is still refused by rpi-eeprom-update.
   RPI_EEPROM_ALLOW_DOWNGRADE=1 rpi-eeprom-config --apply "$WORK/boot.conf" "$image" >> "$MPI_CARD/installer.log" 2>&1 ||
      fail "$MPI_E_FAILED" "updating the bootloader failed"
fi
mpi_state_write "$MPI_IMAGE" "$serial" done "$want" "$layout" "$keep"

# --- 6. restart -----------------------------------------------------------------

mpi_log "done; restarting into $dev"
trap - EXIT
mpi_led steady
sync
systemctl reboot
