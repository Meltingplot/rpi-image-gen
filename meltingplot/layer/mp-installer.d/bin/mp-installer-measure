#!/usr/bin/env python3
"""Measure the raw A/B image an installer card carries.

   zstd -dc image.img.zst | mp-installer-measure [<keep partition> [<skip partition>...]]

Prints one line of seven fields:

  size sha256 keep_start keep_size sha256_keep skip sha256_skip

- size, sha256: the raw image as it is.
- keep_start, keep_size: where the partition lies whose content the card keeps
  on a drive of the same layout (mpinst.keep_part, the audit log).
- skip: the partitions the card never writes (mpinst.skip_parts, the reserve
  of layout gen4, docs/meltingplot-layout.md, LY-10), as name:start:size,
  separated by commas, in the order they lie in the image.
- sha256_skip: the image without the skipped ranges, which is what the drive
  reads back there after the card wrote it.
- sha256_keep: the image without the skipped ranges and the kept one, which
  is what it reads back when the card kept the partition as well.

"-" for a field that does not apply: no such partition, or none named. A
named partition the image does not have is left out, so an image of an
older layout still measures.

The ranges are taken from the primary GPT at the start of the image. The
card skips them with dd in blocks of 4 MiB, so they have to be aligned to
that.
"""

import hashlib
import struct
import sys

SECTOR = 512
BLOCK = 4 << 20
HEAD = 1 << 20


def die(msg):
    sys.exit(f"mp-installer-measure: {msg}")


def gpt_ranges(head):
    hdr = head[SECTOR:2 * SECTOR]
    if hdr[:8] != b"EFI PART":
        die("the image has no GPT")
    entries_lba, count, size = struct.unpack_from("<QII", hdr, 72)
    ranges = {}
    for i in range(count):
        off = entries_lba * SECTOR + i * size
        entry = head[off:off + size]
        if len(entry) < 128:
            die("the GPT entries reach beyond the first MiB")
        first, last = struct.unpack_from("<QQ", entry, 32)
        if not first:
            continue
        name = entry[56:128].decode("utf-16-le").rstrip("\0")
        ranges[name] = (first * SECTOR, (last + 1 - first) * SECTOR)
    return ranges


class Hasher:
    """SHA-256 of the stream without the given byte ranges."""

    def __init__(self, ranges):
        self.ranges = sorted(ranges)
        self.h = hashlib.sha256()

    def update(self, chunk, pos):
        end = pos + len(chunk)
        cur = pos
        for lo, size in self.ranges:
            hi = lo + size
            if hi <= cur or lo >= end:
                continue
            if lo > cur:
                self.h.update(chunk[cur - pos:lo - pos])
            cur = max(cur, min(hi, end))
        if cur < end:
            self.h.update(chunk[cur - pos:])

    def hexdigest(self):
        return self.h.hexdigest()


def main():
    names = sys.argv[1:]
    keep_name = names[0] if names else ""
    skip_names = [n for n in names[1:] if n]
    src = sys.stdin.buffer

    head = src.read(HEAD)
    if len(head) < HEAD:
        die("the image is smaller than its partition table")
    parts = gpt_ranges(head) if (keep_name or skip_names) else {}
    keep = parts.get(keep_name) if keep_name else None
    named = sorted(((parts[n], n) for n in skip_names if n in parts))
    skips = [r for r, _ in named]
    for name, rng in [(keep_name, keep)] + [(n, parts.get(n)) for n in skip_names]:
        if rng and (rng[0] % BLOCK or rng[1] % BLOCK):
            die(f"{name} is not aligned to {BLOCK} bytes")

    h_all = Hasher([])
    h_skip = Hasher(skips)
    h_keep = Hasher(skips + ([keep] if keep else []))
    n = 0
    chunk = head
    while chunk:
        for h in (h_all, h_skip, h_keep):
            h.update(chunk, n)
        n += len(chunk)
        chunk = src.read(BLOCK)

    for rng in skips + ([keep] if keep else []):
        if rng[0] + rng[1] > n:
            die("a partition to keep or skip reaches beyond the end of the image")
    skip_field = ",".join("%s:%d:%d" % (name, r[0], r[1]) for r, name in named) or "-"
    if keep:
        print(n, h_all.hexdigest(), keep[0], keep[1], h_keep.hexdigest(), skip_field, h_skip.hexdigest())
    else:
        print(n, h_all.hexdigest(), "-", "-", "-", skip_field, h_skip.hexdigest())


if __name__ == "__main__":
    main()
