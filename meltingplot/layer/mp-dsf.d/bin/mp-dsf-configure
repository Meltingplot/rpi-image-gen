#!/bin/bash
# Lay out DuetSoftwareFramework for an immutable, A/B root filesystem.
#
# Runs as a customize hook with the rootfs as $1. Three things happen here that
# a stock DSF install does not do:
#
#   * The virtual SD card is split into what the image owns and what the
#     machine owns. Image-owned files sit under /opt/dsf/sd and are pushed over
#     the device's copy on every boot, so an update really updates the printer
#     configuration. Machine-owned files (protected.list) are moved into a
#     skeleton and seeded once, so calibration and customer tuning survive.
#   * Duet Web Control is served from the virtual SD card, not from
#     /opt/dsf/dwc, because that is where DuetWebServer looks and where plugins
#     put their web assets. By the time this runs, /opt/dsf/dwc holds the
#     build from our fork (mp-dsf-dwc).
#   * The printer configuration from chx350-config is baked in.

set -euo pipefail

ROOT=${1:?rootfs}
ASSETS=${IGconf_dsf_assetdir:?}
CONFIG_DIR=${IGconf_dsf_config_dir:?}
DSF_UID=${IGconf_dsf_uid:?}
DSF_VERSION=${IGconf_dsf_version:?}

DSF="$ROOT/opt/dsf"
SD="$DSF/sd"
SKEL="$ROOT/usr/share/meltingplot/dsf-skel"

say() { echo "mp-dsf: $*" >&2; }
die() { echo "mp-dsf: $*" >&2; exit 1; }

[[ -d $DSF ]] || die "/opt/dsf missing, did the DSF packages install?"

# --- accounts -------------------------------------------------------------

have_uid=$(chroot "$ROOT" id -u dsf)
[[ $have_uid == "$DSF_UID" ]] ||
   die "dsf has uid $have_uid, expected $DSF_UID. Files on the persistent
partition are owned numerically, so this has to be stable across builds."
chroot "$ROOT" adduser dsf video >/dev/null

# --- Duet Web Control -----------------------------------------------------
# DuetWebServer serves the object model's web directory, which resolves to
# 0:/www -> /opt/dsf/sd/www. /opt/dsf/dwc is only the fallback used when the
# control server cannot be reached. Make the virtual SD card the real location
# and leave the fallback as a link to it, so both agree and DWC is stored once.

if [[ -L $SD/www ]]; then
   rm -f "$SD/www"
fi
install -d -m 2770 "$SD/www"

if [[ -d $DSF/dwc && ! -L $DSF/dwc ]]; then
   if [[ -n $(ls -A "$DSF/dwc") ]]; then
      cp -a "$DSF/dwc/." "$SD/www/"
   fi
   rm -rf "$DSF/dwc"
fi
[[ -e $DSF/dwc ]] || ln -s /opt/dsf/sd/www "$DSF/dwc"

[[ -f $SD/www/index.html ]] ||
   die "no index.html below /opt/dsf/sd/www, Duet Web Control was not installed"

# --- printer configuration ------------------------------------------------
# Image-owned: replaced by every update, and reset on the next boot if someone
# edits it on the device.

[[ -d $CONFIG_DIR/sys ]] || die "$CONFIG_DIR does not look like chx350-config"

for d in sys macros filaments; do
   [[ -d $CONFIG_DIR/$d ]] || continue
   install -d -m 2770 "$SD/$d"
   rsync -a --exclude='.git' --exclude='.gitignore' --exclude='CLAUDE.md' \
      --exclude='LICENSE' --exclude='README*' \
      "$CONFIG_DIR/$d/" "$SD/$d/"
done

CONFIG_COMMIT=$(git -C "$CONFIG_DIR" rev-parse HEAD 2>/dev/null || echo unknown)
say "printer configuration from chx350-config $CONFIG_COMMIT"

# Every G-code line under sys and macros gets its line number and a CRC-16, so
# a flipped bit in a file on the persistent partition makes DuetControlServer
# reject the line and abort the macro instead of running altered code. The
# tool is the one chx350-config carries. Left out are the machine-owned files,
# whose later edits would break their CRCs, and dsf-config.g, whose M586 C'*'
# cannot take a line number. A plain DSF reads '*' as part of the code, so only
# a build of our own that checks CRCs may run these files.
dcs_ver=$(chroot "$ROOT" dpkg-query -W -f '${Version}' duetcontrolserver)
[[ $dcs_ver =~ \+mp\.([0-9]+)$ ]] && (( BASH_REMATCH[1] >= 7 )) ||
   die "duetcontrolserver $dcs_ver does not check G-code line CRCs, which the
hardened printer configuration needs (3.7.0-rc.1+mp.7 or later)"
crc_args=(-x sys/dsf-config.g)
while read -r pattern; do
   [[ -z $pattern || $pattern == \#* ]] && continue
   crc_args+=(-x "$pattern")
done < "$ASSETS/protected.list"
(cd "$SD" && python3 "$CONFIG_DIR/tools/gcode_crc.py" add sys macros --crc --strict "${crc_args[@]}" >&2) ||
   die "a line of the printer configuration cannot take a line number and CRC"
(cd "$SD" && python3 "$CONFIG_DIR/tools/gcode_crc.py" verify sys macros --crc "${crc_args[@]}" >&2) ||
   die "the printer configuration does not verify after adding CRCs"
say "line numbers and CRCs added to sys and macros"

# The licence notice for the whole image sits next to the printer
# configuration, so it is readable in Duet Web Control as 0:/sys/LICENSES.txt
# and is replaced with every update like the rest of sys. It names the image
# version it was built into, and its firmware paragraph is written from
# firmware.list, so a replaced Duet firmware file is named together with the
# place its modified source is published, and a list without entries says so.
firmware_notice() {
   local list=${IGconf_dsf_firmware_list:-}
   local line name sum url extra n=0
   if [[ -f $list ]]; then
      while IFS= read -r line || [[ -n $line ]]; do
         [[ -z ${line// } || $line == \#* ]] && continue
         read -r name sum url extra <<< "$line"
         if (( n == 0 )); then
            echo "  Modified board firmware (Meltingplot, from RepRapFirmware and"
            echo "  Duet3Expansion): GPL-3.0. These files replace the packaged ones; the"
            echo "  modified source is published where each build is:"
         fi
         n=$((n + 1))
         # A GitHub release asset points at its release page, which is where
         # the tag and the source archive are.
         if [[ $url =~ ^(https://github\.com/[^/]+/[^/]+)/releases/download/([^/]+)/ ]]; then
            echo "    $name: ${BASH_REMATCH[1]}/releases/tag/${BASH_REMATCH[2]}"
         else
            echo "    $name: $url"
         fi
      done < "$list"
   fi
   if (( n == 0 )); then
      echo "  No Duet firmware file is replaced; the boards run the firmware of the"
      echo "  reprapfirmware package."
   fi
}
# The same for DSF packages from a build of our own, from packages.list. The
# version is the one dpkg installed, which is the one the build declares.
package_notice() {
   local list=${IGconf_dsf_packages_list:-}
   local line pkg sum url extra ver n=0
   if [[ -f $list ]]; then
      while IFS= read -r line || [[ -n $line ]]; do
         [[ -z ${line// } || $line == \#* ]] && continue
         read -r pkg sum url extra <<< "$line"
         if (( n == 0 )); then
            echo "  Modified DuetSoftwareFramework packages (Meltingplot, from"
            echo "  DuetSoftwareFramework): GPL-3.0. These are installed in place of the"
            echo "  packages of the Duet3D archive; the modified source is published where"
            echo "  each build is:"
         fi
         n=$((n + 1))
         ver=$(chroot "$ROOT" dpkg-query -W -f '${Version}' "$pkg" 2>/dev/null || true)
         if [[ $url =~ ^(https://github\.com/[^/]+/[^/]+)/releases/download/([^/]+)/ ]]; then
            echo "    $pkg ${ver:-?}: ${BASH_REMATCH[1]}/releases/tag/${BASH_REMATCH[2]}"
         else
            echo "    $pkg ${ver:-?}: $url"
         fi
      done < "$list"
   fi
   if (( n == 0 )); then
      echo "  No DuetSoftwareFramework package comes from a build of our own; the"
      echo "  printer runs the packages of the Duet3D archive."
   fi
}
# The web interface always comes from our fork (mp-dsf-dwc), at the version
# pinned in dsf.dwc_version.
dwc_notice() {
   local ver=${IGconf_dsf_dwc_version:?}
   echo "  Modified Duet Web Control (Meltingplot, from Duet Web Control),"
   echo "  including the CHX 350 operator interface: GPL-3.0. It replaces the web"
   echo "  interface of the duetwebcontrol package; the modified source is"
   echo "  published where the build is:"
   echo "    Duet Web Control $ver: https://github.com/Meltingplot/DuetWebControl/releases/tag/v${ver//+/%2B}"
   echo "  The fonts Jost and JetBrains Mono in it: OFL-1.1."
}
python3 - "$ASSETS/LICENSES.txt" "$SD/sys/LICENSES.txt" \
   "${IGconf_artefact_version:?}" "$(firmware_notice)" "$(package_notice)" \
   "$(dwc_notice)" <<'PY'
import pathlib, sys
src, dst, version, firmware, packages, dwc = sys.argv[1:7]
text = pathlib.Path(src).read_text()
for tag in ("@VERSION@", "@FIRMWARE@", "@PACKAGES@", "@DWC@"):
    if tag not in text:
        sys.exit(f"mp-dsf: LICENSES.txt has no {tag} placeholder")
text = (text.replace("@VERSION@", version)
            .replace("@FIRMWARE@", firmware + "\n")
            .replace("@PACKAGES@", packages + "\n")
            .replace("@DWC@", dwc + "\n"))
pathlib.Path(dst).write_text(text)
PY
chmod 0644 "$SD/sys/LICENSES.txt"
say "licence notice for version ${IGconf_artefact_version} written to sys/LICENSES.txt"

# The printer name is a file of its own, so a customer can rename the machine
# without the change being reverted by the next update, and so the hostname can
# be derived from the same value. dsf-config.g loads it last and guarded by
# fileexists; that call belongs to chx350-config, and postbuild50-dsf-assert
# refuses a configuration without it.
#
# The same name must not also be set in the machine override, or the first M550
# would be rejected by DuetControlServer before printer-name.g ever runs.
for f in "$SD/sys/overrides/dsf-config-override.g" "$SD/sys/meltingplot/dsf-config-override.g"; do
   [[ -f $f ]] && sed -i '/^[[:space:]]*M550[[:space:]]/d' "$f"
done

# --- machine-owned files --------------------------------------------------
# Move everything on the protected list out of the image and into the skeleton.
# What is not in the image is never pushed over the device's copy.

install -d -m 0755 "$SKEL/sd" "$SKEL/conf"

moved=0
while read -r pattern; do
   [[ -z $pattern || $pattern == \#* ]] && continue
   while IFS= read -r rel; do
      [[ -f $SD/$rel ]] || continue
      install -d -m 0755 "$SKEL/sd/$(dirname "$rel")"
      mv -f "$SD/$rel" "$SKEL/sd/$rel"
      moved=$((moved + 1))
   done < <(cd "$SD" && compgen -G "$pattern" || true)
done < "$ASSETS/protected.list"
say "$moved machine-owned files moved into the seed skeleton"

# Autostart list for DuetPluginService. Seeded, never overwritten, so a
# customer can disable a plugin and keep it disabled.
install -m 0644 "$ASSETS/skel/conf/plugins.txt" "$SKEL/conf/plugins.txt"

# --- mount points ---------------------------------------------------------
# Every slot-shared path is bind mounted at boot, so the directory has to exist
# in the read-only image even when the image ships nothing in it.

for d in sys gcodes macros filaments menu www Vigil; do
   install -d -m 2770 "$SD/$d"
done
install -d -m 2770 "$DSF/plugins" "$DSF/conf"

# --- settings we own ------------------------------------------------------

python3 - "$ROOT" <<'PY'
import json, pathlib, sys

root = pathlib.Path(sys.argv[1])

def patch(path, changes):
    p = root / path
    data = {}
    if p.exists():
        try:
            data = json.loads(p.read_text() or "{}")
        except json.JSONDecodeError:
            print(f"mp-dsf: {path} is not valid JSON, replacing it", file=sys.stderr)
    data.update(changes)
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(data, indent=2) + "\n")

# DuetControlServer. Plugin support stays on because the image ships Vigil, but
# a plugin can never gain root and can never install packages.
patch("opt/dsf/conf/config.json", {
    "PluginSupport": True,
    "RootPluginSupport": False,
})

# DuetPluginService. AppArmor profile generation is off because the profiles
# would have to be written to /etc/apparmor.d on a read-only root; the image
# ships a fixed profile chain instead. The package managers are disarmed so a
# plugin's dependencies can never be installed on the device.
patch("opt/dsf/conf/plugins.json", {
    "DisableAppArmor": True,
    "PreinstallPackageCommand": "/bin/false",
    "InstallPackageCommand": "/bin/false",
    "InstallLocalPackageCommand": "/bin/false",
    "UninstallLocalPackageCommand": "/bin/false",
    "InstallPythonPackageCommand": "/bin/false",
})
PY

# --- ownership ------------------------------------------------------------
# DSF runs with UMask=0002, so group write and setgid directories are what it
# expects. /opt/dsf/bin stays root-owned and executable.

for d in "$SD" "$DSF/conf" "$DSF/plugins" "$SKEL"; do
   [[ -d $d ]] || continue
   chown -R "$DSF_UID:$DSF_UID" "$d"
   find "$d" -type d -exec chmod 2770 {} +
   find "$d" -type f -exec chmod 0660 {} +
done

say "DSF $DSF_VERSION laid out for an immutable root"
