#!/bin/bash
# Ship Duet Web Control from our fork in place of the packaged one.
#
# The web interface is Meltingplot/DuetWebControl, the upstream code of the
# pinned generation plus our changes, among them the CHX 350 operator
# interface. Each release of the fork publishes DuetWebControl-SBC.zip, the
# same archive the upstream packaging puts into the duetwebcontrol package
# and the one DSF unpacks into 0:/www when a DWC zip is uploaded on an SBC.
#
# The duetwebcontrol package itself stays installed from the Duet3D archive:
# the meta package duetsoftwareframework, ours included, pins it to exactly
# the archive's version, so a package of our own could not satisfy it. Only
# its files are replaced, here, before mp-dsf-configure moves /opt/dsf/dwc to
# the virtual SD card, so the layout that follows is the same as for the
# packaged web interface.
#
# Only a published release asset is ever used, verified against its pin;
# there is no local path and no fallback. A prerelease is allowed as long as
# the image itself is a prerelease; the release gate enforces that.

set -euo pipefail

ROOT=${1:?rootfs}
DWC_VERSION=${IGconf_dsf_dwc_version:?}
DWC_SHA256=${IGconf_dsf_dwc_sha256:?}
DSF_VERSION=${IGconf_dsf_version:?}

REPO=https://github.com/Meltingplot/DuetWebControl
ASSET=DuetWebControl-SBC.zip
DWC_DIR=/opt/dsf/dwc

say() { echo "mp-dsf-dwc: $*" >&2; }
die() { echo "mp-dsf-dwc: $*" >&2; exit 1; }

# DWC and DSF are released together and carry the same version upstream. The
# fork is of the pinned generation and adds a suffix, 3.7.0-rc.1+mp.1 for
# DSF 3.7.0~rc.1, which is what DWC then shows as its version.
base=${DSF_VERSION//\~/-}
[[ $DWC_VERSION == "$base"+?* ]] || die "\
dsf.dwc_version is $DWC_VERSION, expected $base+<suffix>.

The web interface has to be of the DuetSoftwareFramework generation the image
carries, $DSF_VERSION, and carry a suffix of its own: set the version in the
fork's package.json to $base+<suffix> before releasing it."
[[ $DWC_SHA256 =~ ^[0-9a-f]{64}$ ]] || die "dsf.dwc_sha256 '$DWC_SHA256' is not 64 hex digits"
[[ -f $ROOT$DWC_DIR/index.html ]] ||
   die "no index.html below $DWC_DIR, did the duetwebcontrol package install?"

tag=v$DWC_VERSION
url="$REPO/releases/download/${tag//+/%2B}/$ASSET"

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# vfetch verifies the checksum and keeps a verified copy in the build cache.
say "fetching $ASSET of $tag"
printf '%s sha256:%s %s\n' "$ASSET" "$DWC_SHA256" "$url" > "$tmp/dwc.meta"
vfetch "$tmp/dwc.meta" "$tmp/dwc.zip" || die "\
could not obtain $ASSET with checksum $DWC_SHA256 from
  $url

Either Duet Web Control $DWC_VERSION is not released there, or the asset does
not match the pin. The image only ever ships published builds, so there is
nothing to fall back to: release the fork, or point dsf.dwc_version and
dsf.dwc_sha256 at a release that exists. Do not build past this."

# --- unpack and check -----------------------------------------------------
# The bundle names its own version; it has to be the pinned one, so a pin
# that points at the wrong release is caught here and not on a printer.

python3 - "$tmp/dwc.zip" "$tmp/x" "$DWC_VERSION" <<'PY'
import pathlib, re, sys, zipfile

archive, dest, want = sys.argv[1], pathlib.Path(sys.argv[2]), sys.argv[3]

with zipfile.ZipFile(archive) as z:
    for name in z.namelist():
        if name.startswith("/") or ".." in pathlib.PurePosixPath(name).parts:
            sys.exit(f"mp-dsf-dwc: refusing path {name!r} in the archive")
    z.extractall(dest)

if not (dest / "index.html").is_file():
    sys.exit("mp-dsf-dwc: the archive has no index.html at its top level")
literal = re.compile(r"""[`"']%s[`"']""" % re.escape(want))
if not any(literal.search(p.read_text(errors="replace")) for p in dest.glob("js/*.js")):
    sys.exit(f"mp-dsf-dwc: the bundle does not carry the version {want}; "
             "the pin points at a different build")
PY

# --- replace --------------------------------------------------------------

find "$ROOT$DWC_DIR" -mindepth 1 -delete
cp -r "$tmp/x/." "$ROOT$DWC_DIR/"
find "$ROOT$DWC_DIR" -type d -exec chmod 0755 {} +
find "$ROOT$DWC_DIR" -type f -exec chmod 0644 {} +

say "Duet Web Control $DWC_VERSION from $REPO/releases/tag/${tag//+/%2B}"
