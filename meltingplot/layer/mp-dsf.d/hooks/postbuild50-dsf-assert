#!/bin/bash
# Check the properties the DSF layout depends on, before an image is built.
#
# Most of these are quiet failures on a device: nothing breaks at build time,
# the printer just loses the customer's calibration on the next boot, or a
# plugin policy silently does not apply. They are cheap to assert here.

set -euo pipefail

ROOT=${1:?rootfs}
ASSETS=${IGconf_dsf_assetdir:?}
DSF_UID=${IGconf_dsf_uid:?}

DSF="$ROOT/opt/dsf"
SD="$DSF/sd"
SKEL="$ROOT/usr/share/meltingplot/dsf-skel"

fail=0
bad() { echo "mp-dsf assert: $*" >&2; fail=1; }

# --- the machine keeps its own files --------------------------------------
# Anything the image ships below a slot-shared path overwrites the device's
# copy on every boot. A protected file left in the image would therefore reset
# a customer's tuning at each start, which is the one failure this whole layout
# exists to prevent.

while read -r pattern; do
   [[ -z $pattern || $pattern == \#* ]] && continue
   while IFS= read -r rel; do
      bad "$rel is in the image but is machine-owned; it must live in the seed skeleton"
   done < <(cd "$SD" && compgen -G "$pattern" || true)
done < "$ASSETS/protected.list"

[[ -d $SKEL/sd ]] || bad "no seed skeleton below $SKEL/sd"
[[ -f $SKEL/conf/plugins.txt ]] || bad "the plugin autostart list is not in the skeleton"

# Directories that only ever hold what the machine produced.
for d in sd/gcodes sd/menu sd/Vigil plugins; do
   [[ -d $DSF/$d ]] || { bad "/opt/dsf/$d is missing; it is a bind mount point"; continue; }
   [[ -z $(ls -A "$DSF/$d") ]] || bad "/opt/dsf/$d ships files, so the machine's would be overwritten"
done

# /opt/dsf/conf is slot-shared, so whatever the image ships here is pushed over
# the device's copy on every boot. That is right for these four and wrong for
# anything else, because none of these is ever written by the machine:
#
#   config.json    DuetControlServer, patched by mp-dsf-configure
#   plugins.json   DuetPluginService, patched by mp-dsf-configure
#   http.json      DuetWebServer's Kestrel settings, the package default
#   apparmor.conf  the per-plugin profile template DuetPluginService would
#                  generate from, unused because plugins.json turns that
#                  generation off in favour of the fixed profile chain
#
# A file that is not one of these is either machine state, which must not be in
# the image at all, or a new setting nobody has decided about yet.
while IFS= read -r f; do
   case $(basename "$f") in
      config.json|plugins.json|http.json|apparmor.conf) ;;
      *) bad "/opt/dsf/conf/$(basename "$f") is in the image and would overwrite the machine's copy" ;;
   esac
done < <(find "$DSF/conf" -maxdepth 1 -type f)

# --- the printer actually works -------------------------------------------

[[ -f $SD/sys/config.g ]] || bad "no config.g: the printer configuration was not baked in"
[[ -f $SD/www/index.html ]] || bad "no index.html below sd/www: Duet Web Control is not where DuetWebServer looks"
# The web interface served is the one of the installed duetwebcontrol
# package, and not a copy left over from somewhere else; the bundle names its
# version as a string literal, with a hyphen where the package has a tilde.
dwc_ver=$(dpkg-query --admindir="$ROOT/var/lib/dpkg" -W -f '${Version}' duetwebcontrol 2>/dev/null || true)
dwc_ver=${dwc_ver//\~/-}
if [[ -z $dwc_ver ]]; then
   bad "duetwebcontrol is not installed"
elif ! grep -qF -e "\`$dwc_ver\`" -e "\"$dwc_ver\"" "$SD"/www/js/*.js 2>/dev/null; then
   bad "sd/www does not carry Duet Web Control $dwc_ver of the duetwebcontrol package"
fi
if ! { [[ -f $SD/sys/dsf-config.g ]] && grep -q 'printer-name.g' "$SD/sys/dsf-config.g"; }; then
   bad "dsf-config.g does not load printer-name.g, so the printer name would not apply"
fi

# duetruntime does not depend on ICU, but DuetPluginService and the duettools
# abort at startup without it. The package list asks for it; make sure it came.
compgen -G "$ROOT/usr/lib/*/libicuuc.so.*" >/dev/null ||
   bad "libicu is not installed, so DuetPluginService and the duettools abort at startup"

uid=$(awk -F: '$1=="dsf"{print $3}' "$ROOT/etc/passwd")
[[ $uid == "$DSF_UID" ]] ||
   bad "dsf has uid ${uid:-none}, expected $DSF_UID; persistent files are owned numerically"

# --- licence notice -------------------------------------------------------

lic="$ROOT/opt/dsf/sd/sys/LICENSES.txt"
[[ -s $lic ]] || bad "sys/LICENSES.txt is missing, the image would ship without its licence notice"
grep -q '@[A-Z]*@' "$lic" && bad "sys/LICENSES.txt still carries a placeholder"
if [[ -f ${IGconf_dsf_firmware_list:-} ]]; then
   while IFS= read -r line || [[ -n $line ]]; do
      [[ -z ${line// } || $line == \#* ]] && continue
      read -r fw _ <<< "$line"
      grep -q "^    $fw: " "$lic" ||
         bad "sys/LICENSES.txt does not name the replaced firmware file $fw"
   done < "$IGconf_dsf_firmware_list"
fi
if [[ -f ${IGconf_dsf_packages_list:-} ]]; then
   while IFS= read -r line || [[ -n $line ]]; do
      [[ -z ${line// } || $line == \#* ]] && continue
      read -r pkg _ <<< "$line"
      grep -Eq "^    $pkg [^:]+: " "$lic" ||
         bad "sys/LICENSES.txt does not name the package $pkg from our own build with its version"
   done < "$IGconf_dsf_packages_list"
fi

# --- the bundled plugin ---------------------------------------------------

[[ -f $SKEL/plugins/Vigil.json ]] || bad "Vigil was not staged into the skeleton"
venv_python="$SKEL/plugins/Vigil/venv/bin/python"
if [[ -L $venv_python ]]; then
   target=$(readlink "$venv_python")
   [[ $target == /usr/bin/python3* || $target == python3* ]] ||
      bad "the Vigil virtual environment points at $target, which will not exist on the device"
else
   bad "the Vigil virtual environment has no python"
fi

# --- boot configuration ---------------------------------------------------

grep -q '^dtparam=spi=on' "$ROOT/boot/firmware/config.txt" ||
   bad "SPI is not enabled, so DuetControlServer cannot reach the mainboard"
grep -q 'lsm=apparmor' "$ROOT/boot/firmware/cmdline.txt" ||
   bad "lsm=apparmor is missing from the kernel command line, so the plugin policy would not load"
grep -q 'cgroup_enable=memory' "$ROOT/boot/firmware/cmdline.txt" ||
   bad "cgroup_enable=memory is missing from the kernel command line, so MemoryMin in duetcontrolserver.service would be a no-op"

# --- plugin policy --------------------------------------------------------

profile="$ROOT/etc/apparmor.d/opt.dsf.bin.DuetPluginService"
if [[ -f $profile ]]; then
   if grep -q '__MP_MODE__' "$profile"; then
      bad "the AppArmor profile still carries its mode placeholder"
   fi

   # A plugin must not be able to start another program. Everything the child
   # profile may do is listed explicitly, so any exec permission in it is a
   # mistake.
   if awk '/profile dsf_plugin_py/,/^  }$/' "$profile" |
        grep -v '^[[:space:]]*#' |
        grep -Eq '[[:space:]][a-zA-Z]*x[a-zA-Z]*,[[:space:]]*$'; then
      bad "the dsf_plugin_py profile grants an exec permission"
   fi

   # The service runs with NoNewPrivileges, and under no_new_privs the kernel
   # denies an exec that leaves the current profile. Only a stacked transition
   # ("ix -> &profile") gets a plugin started at all; a child transition would
   # fail with info="no new privs" and nothing would ever run.
   if grep -v '^[[:space:]]*#' "$profile" | grep -Eq '[[:space:]][Cc]i?u?x[[:space:]]'; then
      bad "the AppArmor profile uses a child transition, which NoNewPrivileges denies"
   fi

   # -Q: parse only, do not load into the kernel. -K: touch no policy cache,
   # which an unprivileged build host may not write.
   if command -v apparmor_parser >/dev/null 2>&1; then
      apparmor_parser -Q -K --base "$ROOT/etc/apparmor.d" "$profile" >/dev/null ||
         bad "the AppArmor profile does not parse"
   else
      echo "mp-dsf assert: apparmor_parser not on the build host, profile syntax unchecked" >&2
   fi
else
   bad "the AppArmor plugin policy is missing"
fi

# --- restarts and firmware ------------------------------------------------
# The update connector may only run while the printer is idle, which is
# mp-ota-gate's job, and the firmware only follows a committed slot. The gate
# rests on the connector being enabled, so that it commits a trybooted slot
# at boot on its own, and on its packaged defaults, which mp-connect asserts.

if [[ -f $ROOT/etc/rpi-connect/rpi-ota-connector.config ]]; then
   compgen -G "$ROOT/etc/systemd/system/*.wants/rpi-connect-ota.service" >/dev/null ||
      bad "rpi-connect-ota.service is not enabled, a trybooted slot would never be committed"
else
   echo "mp-dsf assert: no update connector in this image, mp-ota-gate has nothing to gate" >&2
fi

for unit in mp-ota-gate.timer mp-dsf-firmware.service; do
   compgen -G "$ROOT/etc/systemd/system/*.wants/$unit" >/dev/null ||
      bad "$unit is not enabled"
done

# mp-dsf-firmware reads the mainboard reset setting from dsf.conf and takes a
# missing or unreadable file as n, so a release built to reset would quietly
# not do it.
want=${IGconf_dsf_mainboard_reset_after_update:-n}
have=$(sed -n 's/^MP_MAINBOARD_RESET=//p' "$ROOT/etc/meltingplot/dsf.conf" 2>/dev/null || true)
[[ $have == "$want" ]] ||
   bad "/etc/meltingplot/dsf.conf has MP_MAINBOARD_RESET=${have:-nothing}, the build asked for $want"

# --- replaced firmware files ----------------------------------------------
# A file from the list has to be the pinned build, and it has to have gone in
# through dpkg-divert: a copy dropped over the packaged file looks the same
# to RepRapFirmware but leaves dpkg believing its own file is still there.

list=${IGconf_dsf_firmware_list:-}
if [[ -f $list ]]; then
   while read -r name sum _ || [[ -n $name ]]; do
      [[ -z $name || $name == \#* ]] && continue
      f="$SD/firmware/$name"
      if [[ ! -f $f ]]; then
         bad "$name is listed for replacement but is not in the image"
         continue
      fi
      want=${sum#sha256:}
      [[ $(sha256sum "$f" | cut -d' ' -f1) == "${want,,}" ]] ||
         bad "$name is not the pinned build $want"
      grep -qx "/opt/dsf/sd/firmware/$name" "$ROOT/var/lib/dpkg/diversions" 2>/dev/null ||
         bad "$name was replaced without dpkg-divert, so dpkg still claims the packaged file"
   done < "$list"
fi

# --- packages from a build of our own -------------------------------------
# A package from the packages list has to be installed at the version of the
# pinned build, and its files on disk have to be the build's, file for file.
# The Duet packages carry no md5sums, so the pinned .deb itself is the
# reference; it is taken from the build cache, where vfetch left it verified.
# Conffiles are left out: the image configures the packages itself.

list=${IGconf_dsf_packages_list:-}
if [[ -f $list ]]; then
   tmp=$(mktemp -d)
   trap 'rm -rf "$tmp"' EXIT
   while read -r pkg sum url || [[ -n $pkg ]]; do
      [[ -z $pkg || $pkg == \#* ]] && continue
      deb=$tmp/$pkg.deb
      printf '%s %s %s\n' "$pkg.deb" "$sum" "$url" > "$tmp/$pkg.meta"
      if ! vfetch "$tmp/$pkg.meta" "$deb" >/dev/null 2>&1; then
         bad "the pinned build of $pkg (${sum#sha256:}) is not in the build cache, so the image cannot be checked against it"
         continue
      fi
      ver=$(dpkg-deb -f "$deb" Version)
      have=$(dpkg-query --admindir="$ROOT/var/lib/dpkg" -W -f '${Version}' "$pkg" 2>/dev/null || true)
      if [[ $have != "$ver" ]]; then
         bad "$pkg is installed at ${have:-no version}, the pinned build is $ver"
         continue
      fi
      conffiles=$(dpkg-deb --ctrl-tarfile "$deb" | tar -xOf - ./conffiles 2>/dev/null || true)
      stage=$tmp/$pkg.files
      mkdir -p "$stage"
      dpkg-deb --fsys-tarfile "$deb" | tar -C "$stage" -xf -
      while IFS= read -r path; do
         grep -qx "$path" <<< "$conffiles" && continue
         if [[ -L $stage$path ]]; then
            [[ -L $ROOT$path && $(readlink "$stage$path") == $(readlink "$ROOT$path") ]] ||
               bad "$path is not the link the pinned build of $pkg ships"
         elif ! cmp -s "$stage$path" "$ROOT$path"; then
            bad "$path is not the pinned build of $pkg $ver"
         fi
      done < <(cd "$stage" && find . -type f -o -type l | sed 's|^\.||')
   done < "$list"
fi

[[ $fail -eq 0 ]] || exit 1
echo "mp-dsf assert: layout, plugin policy, boot configuration and update path are consistent" >&2
