#!/bin/bash
# Mark every file the image ships below the shared paths of dsf.conf as owned
# by the image, in slot-shared.d/dsf-static.conf.
#
# slot-state only adds files missing from the shared copy and never
# overwrites one. The printer configuration and Duet Web Control live in
# shared paths, and an update has to bring their new versions: a StaticPath
# is removed from the shared copy and put back from the active slot on every
# boot. Listed file by file, so whatever the device added next to them stays:
# the machine's own files in sys/overrides and sys/generated (protected.list,
# never in the image), uploaded jobs, filament profiles made in DWC, the web
# files of a plugin installed later.
#
# Names may hold spaces (filament profiles such as "PLA 1.2mm"), which
# slot-state takes in a StaticPath. What it cannot take stops the build here,
# with the file named: a symlink, which slot-state refuses to put back, and a
# name with a character systemd-tmpfiles would read as a glob or a specifier,
# which would remove other files than this one, or with other whitespace than
# a space.

set -euo pipefail

ROOT=${1:?root filesystem}
dir=$ROOT/etc/rpi-image-gen/slot-shared.d
conf=$dir/dsf.conf
out=$dir/dsf-static.conf

die() { echo "mp-dsf: $*" >&2; exit 1; }

[[ -f $conf ]] || die "$conf is missing"

{
   echo "# Written by rpi-image-gen layer mp-dsf (postbuild40-dsf-static): every"
   echo "# file the image ships below the paths of dsf.conf, put back from the"
   echo "# active slot on every boot. Files the device added stay."
   echo "Version=1"
   while IFS= read -r line || [[ -n $line ]]; do
      case $line in
         SharedPath=*) path=${line#SharedPath=} ;;
         Path=*)       path=${line#Path=} ;;
         *)            continue ;;
      esac
      path=/${path#/}
      path=${path%/}
      [[ -d $ROOT$path ]] || continue
      while IFS= read -r -d '' f; do
         rel=${f#"$ROOT"}
         [[ ! -L $f ]] || die "$rel is a symlink, which slot-state cannot put back on boot"
         [[ $rel != *[*?[%\\]* ]] || die "$rel has a glob or specifier character in its name"
         [[ $rel != *[[:space:]]* || ${rel//[^[:space:]]/} =~ ^\ +$ ]] ||
            die "$rel has whitespace other than spaces in its name"
         printf 'StaticPath=%s\n' "$rel"
      done < <(find "$ROOT$path" -mindepth 1 \( -type f -o -type l \) -print0 | sort -z)
   done < "$conf"
} > "$out"
chmod 0644 "$out"

echo "mp-dsf: $(grep -c '^StaticPath=' "$out") files below the shared paths are put back on every boot" >&2
