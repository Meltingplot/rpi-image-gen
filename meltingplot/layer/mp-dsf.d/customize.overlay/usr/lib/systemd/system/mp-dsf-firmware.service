[Unit]
Description=Bring the Duet firmware to the version this image carries
# After the control server, which does the flashing on request, and after the
# update connector, which commits a freshly trybooted slot. The script waits
# for both on its own; the ordering only spares it the wait.
After=duetcontrolserver.service rpi-connect-ota.service
RequiresMountsFor=/bootfs
ConditionPathExists=/opt/dsf/bin/DuetControlServer

[Service]
# Not a oneshot: the script settles for minutes before it does anything, and
# a oneshot would hold multi-user.target back for as long as it runs. The
# packaged DuetPluginService units start only after that target, so a
# oneshot here would keep every plugin from starting until the firmware check
# was through, and Duet Web Control would report the plugin service as not
# started in the meantime. With exec the start job is done once the script
# runs, and the target is reached without it.
Type=exec
ExecStart=/usr/sbin/mp-dsf-firmware
# Three minutes of settling, two waits of up to five minutes, then every
# board on the CAN bus.
RuntimeMaxSec=30min

[Install]
WantedBy=multi-user.target
