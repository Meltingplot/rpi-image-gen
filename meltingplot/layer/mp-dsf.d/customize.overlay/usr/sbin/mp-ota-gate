#!/bin/sh
# Let the Raspberry Pi Connect update connector run only while the printer is
# idle, and tell whoever stands at the printer while it installs an update.
#
# The connector installs a deployment the moment it arrives and restarts the
# machine the moment the install is done. Nothing in the packaged software
# holds that restart back. With AutoReboot=false the connector asks the
# Connect daemon for permission over D-Bus (RebootPrompt), the daemon in this
# image does not implement that method, and a failed call counts as
# permission (rpi-connect-ota 1.3.14 with rpi-connect 2.12.2, read from the
# binaries after a restart in the middle of a print on 2026-09-12).
#
# So the gate is the connector's service itself. This runs every minute from
# mp-ota-gate.timer. While RepRapFirmware reports the machine idle the
# connector runs, and a deployment created in Connect is installed and
# restarts the machine within minutes. While it reports anything else, or
# cannot be asked, the connector is stopped and a deployment stays pending in
# Connect until the print is over. The connector is enabled, so it runs at
# boot regardless and commits a freshly trybooted slot before this timer
# fires for the first time; until that commit is through it is left alone
# whatever the printer does, since the restart this guards against has
# already happened.
#
# Stopping the connector in the middle of an install is fine: nothing it has
# written is a slot the bootloader would start, and it picks the deployment
# up again once it runs. What remains is the minute between a print starting
# and this timer firing: an install that completes within that minute
# restarts the machine.
#
# While the connector reports an install in progress, the printer shows the
# update notice, refreshed on every run so its timeout never expires ahead of
# the restart. The restart takes the notice down with the control server;
# mp-dsf-firmware puts it back, keeps it up through the firmware update and
# then tells the printer that the update is complete. An
# install that ends without a restart (it failed, or the connector was
# stopped) closes the notice on the next run. The flag under /run remembers
# that this gate put the notice up, so it never closes a message box that a
# later boot put up.
#
# A control server that stays unreachable, or a mainboard that stays
# disconnected from it, lets the connector run once that has lasted
# MP_DOWN_GRACE seconds without a break. No print runs meanwhile: in SBC mode
# RepRapFirmware gets every line of a job from the control server. And it is
# the only way a release that breaks either can be replaced remotely, since
# the Connect shell cannot become root to start the connector by hand. The
# time is counted from the uptime, not the clock, which jumps when the
# machine, which has no RTC, first reaches its time server.

set -eu

MP_TAG=mp-ota-gate
MP_LIB=${MP_LIB:-/usr/lib/meltingplot}
# shellcheck source=/dev/null
. "$MP_LIB/mp-common.sh"
# shellcheck source=/dev/null
. "$MP_LIB/mp-dsf.sh"

SYSTEMCTL=${MP_SYSTEMCTL:-systemctl}
UNIT=rpi-connect-ota.service
NOTICE_FLAG=${MP_NOTICE_FLAG:-/run/mp-ota-gate.notice}
DOWN_FLAG=${MP_DOWN_FLAG:-/run/mp-ota-gate.down}
DOWN_GRACE=${MP_DOWN_GRACE:-600}
UPTIME=${MP_UPTIME:-/proc/uptime}

status=$(mp_dcs_status)
active=$("$SYSTEMCTL" is-active "$UNIT" 2>/dev/null || true)

# How long the printer has been out of reach, from the first check that found
# it so. Any other answer starts the count again.
now=$(cut -d. -f1 "$UPTIME")
down=0
case $status in
   '' | disconnected)
      [ -s "$DOWN_FLAG" ] || echo "$now" > "$DOWN_FLAG"
      down=$((now - $(cat "$DOWN_FLAG")))
      ;;
   *)
      rm -f "$DOWN_FLAG"
      ;;
esac

if [ "$status" = idle ]; then
   want=running
elif ! mp_slot_committed; then
   # Not the connector's restart to hold back: this slot was just trybooted
   # and the connector is the one that commits it.
   want=running
elif [ "$down" -ge "$DOWN_GRACE" ]; then
   want=running
else
   want=stopped
fi

case $want:$active in
   running:active | running:activating)
      ;;
   running:*)
      if [ "$down" -ge "$DOWN_GRACE" ]; then
         mp_log "the printer has been ${status:-unreachable} for $((down / 60)) minutes; the update connector runs"
      else
         mp_log "the printer is ${status:-unreachable}; the update connector runs"
      fi
      "$SYSTEMCTL" start "$UNIT"
      ;;
   stopped:active | stopped:activating)
      mp_log "the printer is ${status:-unreachable}; the update connector is stopped until it is idle"
      "$SYSTEMCTL" stop "$UNIT"
      ;;
   stopped:*)
      ;;
esac

# The connector's state is read from the file it keeps, which is only
# current while it runs. It counts only for a connector that was running
# before this run and still is: one stopped this minute reads as not
# installing and its notice comes down right away, and one started this
# minute has not rewritten the file yet, so what it was left saying stays
# out of it.
ota=
case $want:$active in
   running:active | running:activating) ota=$(mp_ota_state) ;;
esac
if mp_ota_installing "$ota"; then
   [ -e "$NOTICE_FLAG" ] || mp_log "the update connector is in state $ota; the printer shows the update notice"
   if mp_ota_notice_show; then
      : > "$NOTICE_FLAG"
   else
      mp_log "the printer cannot be told about the update in progress"
   fi
elif [ -e "$NOTICE_FLAG" ]; then
   mp_log "the update connector is ${ota:-not running}; the update notice comes down"
   mp_ota_notice_close || mp_log "the printer cannot be told that the update is over"
   rm -f "$NOTICE_FLAG"
fi
