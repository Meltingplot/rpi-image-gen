#!/bin/sh
# Bring the Duet boards to the firmware this image was built with.
#
# The mainboard firmware is pinned to the DuetSoftwareFramework version and
# ships in the slot under /opt/dsf/sd/firmware. Nothing in DSF flashes it by
# itself: the version comparison only ever runs as `DuetControlServer -u`,
# which DuetPi triggers from apt and this image triggers here, once per boot.
# Without a terminal on stdin that command flashes every board whose version
# differs from the file, without asking.
#
# Three conditions, all waited for, none forced:
#
#   * The printer must have finished booting. Flashing an expansion board
#     takes it off the CAN bus, and a config.g that cannot reach one of its
#     boards ends in an emergency stop, which cancels the update. RepRap-
#     Firmware reports idle before config.g has reached every board, so a
#     fixed settling time is waited first; a check on the object model can
#     replace it later.
#   * The running slot must be committed. During a tryboot the bootloader
#     falls back to the other slot on the next reset, and that slot expects
#     its own firmware. The update connector commits within seconds of a
#     successful boot, so after an update this is a short wait.
#   * The printer must be idle. Flashing resets the mainboard.
#
# Because every slot does this for itself, a rollback also puts the matching
# firmware back: DuetControlServer flashes on any difference, not only on a
# newer version.
#
# A boot the bootloader started as a tryboot follows an update (or a rollback
# by hand), and the update is not over until the firmware is in step. For
# that boot the printer shows the update notice from the start, and the
# notice comes down when this script is through, whatever the outcome. On
# any other boot the notice is left alone, except that one left over from
# before the restart is closed at the end all the same.

set -eu

MP_TAG=mp-dsf-firmware
. /usr/lib/meltingplot/mp-common.sh
. /usr/lib/meltingplot/mp-dsf.sh

DCS=/opt/dsf/bin/DuetControlServer
SETTLE=${MP_FIRMWARE_SETTLE:-180}
WAIT=${MP_FIRMWARE_WAIT:-300}

# Poll a condition every few seconds until it holds or the wait is used up.
wait_for() {
   _left=$WAIT
   until "$@"; do
      [ "$_left" -gt 0 ] || return 1
      sleep 5
      _left=$((_left - 5))
   done
}

printer_idle() { [ "$(mp_dcs_status)" = idle ]; }

# The control server may still be connecting to the mainboard when this
# starts, so a notice that cannot be shown is tried again after settling.
notice=no
if mp_boot_trybooted; then
   notice=yes
   mp_log "this boot follows an update; the printer shows the update notice"
   mp_ota_notice_show || true
fi

finish() {
   mp_ota_notice_close || mp_log "the printer cannot be told that the update is over"
   exit "${1:-0}"
}

mp_log "waiting ${SETTLE}s for the printer to finish booting"
sleep "$SETTLE"

if [ "$notice" = yes ]; then
   mp_ota_notice_show || mp_log "the printer cannot be told about the update in progress"
fi

if ! wait_for mp_slot_committed; then
   mp_log "this slot is not committed, the firmware stays as it is"
   finish
fi

if ! wait_for printer_idle; then
   mp_log "the printer is '$(mp_dcs_status)', not idle; the firmware stays as it is"
   finish
fi

mp_log "comparing the Duet firmware with this image"
rc=0
"$DCS" -u < /dev/null || rc=$?
finish "$rc"
