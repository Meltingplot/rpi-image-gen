# Plugin policy for DuetSoftwareFramework.
#
# The printer ships with the plugins Meltingplot put in the image. A plugin
# installed later may extend Duet Web Control, but it must never run code on
# the machine: this is a CE-marked printer and everything that executes on it
# has to be part of a released, documented image.
#
# DuetSoftwareFramework has no setting for that. PluginSupport is all or
# nothing and DisablePluginInstallations blocks web-only plugins too, so the
# distinction is drawn here instead. An SBC plugin is started by
# DuetPluginService either directly, or, for Python, as
#
#     /bin/bash -c "<plugin>/venv/bin/python <script>"
#
# so both paths lead through this profile:
#
#   DuetPluginService  may execute nothing that lives on writable storage, and
#                      reaches a shell only by entering dsf_launcher
#   dsf_launcher       may execute nothing but a Python interpreter, which
#                      enters dsf_plugin_py
#   dsf_plugin_py      may read the plugins the image shipped and nothing
#                      else, so a plugin installed later cannot read its own
#                      code, and may execute nothing at all
#
# The parent profile is deliberately broad: confining our own .NET service file
# by file would buy nothing, and the only question this profile answers is what
# may be executed. The two child profiles carry the policy, and they work by
# listing what is allowed - anything not named is denied. Blanket deny rules
# are avoided on purpose, because in AppArmor a deny always beats an allow and
# would take the exec transitions with it.
#
# The service runs with NoNewPrivileges (see the systemd drop-in). Under
# no_new_privs the kernel refuses any exec that would leave the current
# profile behind, because a different profile might grant more; a transition
# is only allowed if the old label stays part of the new one. So the shell is
# not moved into dsf_launcher, it is stacked: "ix -> &<profile>" keeps
# DuetPluginService and adds the child, and the process is confined by both.
# The second hop then replaces the launcher with dsf_plugin_py while the
# parent still stays, which is what no_new_privs asks for. A plain "Cx"
# transition is denied with info="no new privs" in the audit log.
#
# The child profiles are siblings, so the target of a transition between them
# is written with its full name. A "Cx -> name" from inside a child would be
# looked up as "dsf_launcher//name", which does not exist.
#
# A process in a stacked label shows up as
# "DuetPluginService//&DuetPluginService//dsf_plugin_py" in ps -Z and aa-status.
#
# Denials appear as apparmor="DENIED" in `journalctl -k`. Build with
# dsf.plugin_policy=complain to log them without acting on them, which is how
# to widen these lists for a new bundled plugin.

include <tunables/global>

profile DuetPluginService /opt/dsf/bin/DuetPluginService flags=(attach_disconnected__MP_MODE__) {
  include <abstractions/base>
  include <abstractions/nameservice>

  capability,
  network,
  unix,
  signal,
  dbus,
  ptrace,
  file,

  # Nothing on writable storage is ever executed. Unpacking a plugin is
  # allowed; running it is not.
  deny /opt/dsf/** x,
  deny /persistent/** x,
  deny /home/** x,
  deny /tmp/** x,
  deny /var/** x,

  # The one way to a shell, and only to start a Python plugin. Stacked, not
  # entered, because of no_new_privs (see above). The kernel first looks for a
  # top-level profile attached to the shell and would stack onto that instead;
  # the image ships none.
  /{usr/,}bin/bash ix -> &DuetPluginService//dsf_launcher,
  /{usr/,}bin/sh   ix -> &DuetPluginService//dsf_launcher,
  /{usr/,}bin/dash ix -> &DuetPluginService//dsf_launcher,

  profile dsf_launcher flags=(attach_disconnected__MP_MODE__) {
    include <abstractions/base>
    include <abstractions/nameservice>

    signal,
    unix,

    /{usr/,}bin/{bash,sh,dash} rm,
    /usr/lib/@{multiarch}/** mr,
    /usr/share/** r,
    /etc/** r,
    @{PROC}/ r,
    @{PROC}/** r,
    /opt/dsf/** r,
    /persistent/** r,
    owner /tmp/** rw,

    # bash probes for a terminal at startup. There is none, and the probe
    # would otherwise be the one denial that shows up on every plugin start.
    deny /dev/tty rw,

    # The only program a plugin launcher may start. This hop leaves the
    # launcher and enters the plugin profile; DuetPluginService stays stacked
    # on top through its own ix rule, so no_new_privs is satisfied.
    /usr/bin/python3* Px -> DuetPluginService//dsf_plugin_py,
  }

  # The plugin itself. Everything it may touch is listed; anything absent is
  # denied, which is what stops a plugin the image did not ship. There is no
  # exec rule at all, so a plugin can never start another program.
  profile dsf_plugin_py flags=(attach_disconnected__MP_MODE__) {
    include <abstractions/base>
    include <abstractions/nameservice>

    # A signal is mediated on the receiving side as well, so the senders that
    # stop this plugin have to be named. abstractions/base already accepts
    # unconfined ones, which covers systemd on shutdown; DuetPluginService is
    # confined and is what Stop in Duet Web Control goes through, so without
    # the rule below a plugin could be started but never stopped again.
    # Sending stays confined to the plugin itself: it may signal no other
    # process on the machine. The plugin's own label is the stack of the
    # parent and this profile, and a peer rule matches a stacked label as a
    # whole before it falls back to matching each part. Naming the whole
    # stack allows the plugin to signal itself without also allowing it to
    # signal DuetPluginService, whose label is the bare parent.
    signal (receive) peer=DuetPluginService,
    signal (receive) peer=DuetPluginService//dsf_launcher,
    signal (send, receive) peer=DuetPluginService//&DuetPluginService//dsf_plugin_py,

    /usr/bin/python3* rm,
    /usr/lib/python3*/** mr,
    /usr/lib/@{multiarch}/** mr,
    /usr/share/** r,
    /etc/** r,
    @{PROC}/ r,
    @{PROC}/** r,
    /sys/class/** r,
    /sys/devices/** r,
    /sys/firmware/devicetree/** r,

    # dsf-python looks up the control server socket in its configuration and
    # falls back to the default path when it cannot; reading it keeps the two
    # in step.
    /opt/dsf/conf/config.json r,

    # Plugins that came with the image (layer/mp-dsf.d/plugins.list). One
    # block per bundled plugin; a plugin installed later has no block here and
    # cannot read its own files. The post-build assert refuses a block for a
    # plugin the image does not bundle, since a plugin of that name installed
    # later would then run.
    #
    # The build precompiles each plugin, so Python has nothing to write into
    # its __pycache__. Should the cache still be stale, writing it is
    # harmless: the plugin already runs this code, and the directory is its
    # own.
    #
    # All bundled plugins run in this one profile, so what one of them may
    # read, all of them may. They all come from us; what the profile keeps
    # out is every plugin that does not.

    # Vigil, machine monitoring
    /opt/dsf/plugins/Vigil.json r,
    /opt/dsf/plugins/Vigil/** mr,
    owner /opt/dsf/plugins/Vigil/dsf/__pycache__/ w,
    owner /opt/dsf/plugins/Vigil/dsf/__pycache__/* rw,
    # its counters and history on the virtual SD card
    /opt/dsf/sd/Vigil/ rw,
    /opt/dsf/sd/Vigil/** rwk,

    # CHX350, the backend of the CHX 350 operator interface in Duet Web
    # Control. It writes nothing. It reads the slicer settings at the end of a
    # job file, whose path DuetControlServer resolves, and the job history in
    # RepRapFirmware's event log (M929 in config.g).
    /opt/dsf/plugins/CHX350.json r,
    /opt/dsf/plugins/CHX350/** mr,
    owner /opt/dsf/plugins/CHX350/dsf/__pycache__/ w,
    owner /opt/dsf/plugins/CHX350/dsf/__pycache__/* rw,
    /opt/dsf/sd/gcodes/ r,
    /opt/dsf/sd/gcodes/** r,
    /opt/dsf/sd/sys/eventlog.log r,

    # The control server socket, which the plugin connects to, and its own
    # HTTP endpoints, which it serves: DuetControlServer creates the namespace
    # directory under /run/dsf and the plugin binds one socket per endpoint in
    # it, then DuetWebServer connects to those. An endpoint path may contain a
    # slash (Vigil registers service/reset and friends), which becomes a
    # subdirectory that DuetControlServer also creates, so the whole tree is
    # the plugin's. The namespace is its own, so it cannot bind or replace
    # another plugin's sockets.
    /run/dsf/ r,
    /run/dsf/* rw,
    /run/dsf/Vigil/{,**/} r,
    /run/dsf/Vigil/** rw,
    /run/dsf/CHX350/{,**/} r,
    /run/dsf/CHX350/** rw,
    unix (bind, listen, accept, connect, send, receive) type=stream,

    owner /tmp/** rw,
  }
}
