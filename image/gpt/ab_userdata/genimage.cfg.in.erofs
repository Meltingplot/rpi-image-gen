image <IMAGE_NAME>.<IMAGE_SUFFIX>.sparse {
   android-sparse {
      image = <IMAGE_NAME>.<IMAGE_SUFFIX>
   }
}

image bootconfig.sparse {
   android-sparse {
      image = bootconfig.vfat
   }
}

image boot.sparse {
   android-sparse {
      image = boot.vfat
   }
}

image system.sparse {
   android-sparse {
      image = system.erofs
   }
}

image data.sparse {
   android-sparse {
      image = persistent.ext4
   }
}

image <IMAGE_NAME>.<IMAGE_SUFFIX> {
   hdimage {
      align = 8M
      partition-table-type = "gpt"
      fill = true
   }

   partition bootconfig {
      in-partition-table = true
      image = bootconfig.vfat
      partition-type-uuid = F
      bootable = true
   }

   partition boot_a {
      in-partition-table = true
      image = boot.vfat
      partition-type-uuid = F
      bootable = true
   }

   partition boot_b {
      in-partition-table = true
      image = boot.vfat
      partition-type-uuid = F
      bootable = true
   }

   partition system_a {
      in-partition-table = true
      image = system.erofs
      partition-type-uuid = L
   }

   partition system_b {
      in-partition-table = true
      image = system.erofs
      partition-type-uuid = L
   }

#PRIVATE_BEGIN
   # Not mounted by the system; see image.private_part_name
   partition <PRIVATE_NAME> {
      in-partition-table = true
      image = private.ext4
      partition-type-uuid = L
   }

#PRIVATE_END
   partition persistent {
      in-partition-table = true
      image = persistent.ext4
      partition-type-uuid = L
   }
}

image bootconfig.vfat {
   vfat {
      label = "BOOTCONFIG"
      extraargs = "-s 1 -S <SECTOR_SIZE>"
   }
   size = 32M
   mountpoint = "/bootfs"
}

image boot.img {
   vfat {
      label = "BOOTRD"
      extraargs = "-S <SECTOR_SIZE> --invariant"
   }
   size = 100%
   mountpoint = "/boot/firmware"
}

image boot.vfat {
   vfat {
      label = "BOOT"
      extraargs = "-S <SECTOR_SIZE> -i <BOOT_LABEL>"
      file boot.img { image = "boot.img" }
   }
   size = <BOOT_SIZE>
   exec-post = "bootimg ramdisk boot.img"
}

image system.erofs {
   erofs {
      extraargs = "<EROFS_SYSTEM>"
   }
   size = <SYSTEM_SIZE>
   mountpoint = "/"
   exec-pre = "<SLOTP> SYSTEM"
}

image system.verity {
   verity {
      image = "system.erofs"
      extraargs = "<VERITY_SYSTEM>"
   }
}

#PRIVATE_BEGIN
image private.sparse {
   android-sparse {
      image = private.ext4
   }
}

image private.ext4 {
   ext4 {
      use-mke2fs = true
      label = "<PRIVATE_LABEL>"
      extraargs = "<MKE2FS_DATA>"
   }
   empty = true
   size = <PRIVATE_SIZE>
}

#PRIVATE_END
image persistent.ext4 {
   ext4 {
      use-mke2fs = true
      label = "PERSISTENT"
      extraargs = "<MKE2FS_DATA>"
   }
   mountpoint = "/persistent"
   size = <PERSISTENT_SIZE>
}
