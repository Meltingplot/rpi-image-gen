image <IMAGE_NAME>.<IMAGE_SUFFIX>.sparse {
   android-sparse {
      image = <IMAGE_NAME>.<IMAGE_SUFFIX>
   }
}

image bootconfig.sparse {
   android-sparse {
      image = bootconfig.vfat
   }
}

image boot.sparse {
   android-sparse {
      image = boot.vfat
   }
}

image system.sparse {
   android-sparse {
      image = system.ext4
   }
}

image data.sparse {
   android-sparse {
      image = persistent.ext4
   }
}

image <IMAGE_NAME>.<IMAGE_SUFFIX> {
   hdimage {
      align = 8M
      partition-table-type = "gpt"
      fill = true
   }

   partition bootconfig {
      in-partition-table = true
      image = bootconfig.vfat
      partition-type-uuid = F
      bootable = true
   }

   partition boot_a {
      in-partition-table = true
      image = boot.vfat
      partition-type-uuid = F
      bootable = true
   }

   partition boot_b {
      in-partition-table = true
      image = boot.vfat
      partition-type-uuid = F
      bootable = true
   }

   partition system_a {
      in-partition-table = true
      image = system.ext4
      partition-type-uuid = L
   }

   partition system_b {
      in-partition-table = true
      image = system.ext4
      partition-type-uuid = L
   }

#PRIVATE_BEGIN
   # Not mounted by the system; see image.private_part_name
   partition <PRIVATE_NAME> {
      in-partition-table = true
      image = <PRIVATE_IMAGE>
      partition-type-uuid = L
   }

#PRIVATE_END
#RESERVE_BEGIN
   # Never mounted; space for a later change of the layout, see
   # image.reserve_part_size
   partition reserve {
      in-partition-table = true
      image = reserve.raw
      partition-type-uuid = 8DA63339-0007-60C0-C436-083AC8230908
   }

#RESERVE_END
   partition persistent {
      in-partition-table = true
      image = persistent.ext4
      partition-type-uuid = L
   }
}

image bootconfig.vfat {
   vfat {
      label = "BOOTCONFIG"
      extraargs = "-s 1 -S <SECTOR_SIZE>"
   }
   size = 32M
   mountpoint = "/bootfs"
}

image boot.img {
   vfat {
      label = "BOOTRD"
      extraargs = "-S <SECTOR_SIZE> --invariant"
   }
   size = 100%
   mountpoint = "/boot/firmware"
}

image boot.vfat {
   vfat {
      label = "BOOT"
      extraargs = "-S <SECTOR_SIZE> -i <BOOT_LABEL>"
      file boot.img { image = "boot.img" }
   }
   size = <BOOT_SIZE>
   exec-post = "bootimg ramdisk boot.img"
}

image system.ext4 {
   ext4 {
      use-mke2fs = true
      mke2fs-conf = <MKE2FS_CONF>
      label = "SYSTEM"
      extraargs = "<MKE2FS_SYSTEM>"
   }
   size = <SYSTEM_SIZE>
   mountpoint = "/"
   exec-pre = "<SLOTP> SYSTEM"
}

#PRIVATE_BEGIN
image private.sparse {
   android-sparse {
      image = <PRIVATE_IMAGE>
   }
}

#PRIVATE_EXT4_BEGIN
image private.ext4 {
   ext4 {
      use-mke2fs = true
      label = "<PRIVATE_LABEL>"
      extraargs = "<MKE2FS_DATA>"
   }
   empty = true
   size = <PRIVATE_SIZE>
}

#PRIVATE_EXT4_END
#PRIVATE_RAW_BEGIN
# No filesystem: a file of the partition's size that is all hole, made by
# the template hook. It stays a hole in the disk image and is "don't care"
# in the sparse image, so nothing is written to the partition. holes says
# so, and gives the section the content image2json needs to tell its type.
image private.raw {
   file {
      holes = {"(0; <PRIVATE_SIZE>)"}
   }
}

#PRIVATE_RAW_END
#PRIVATE_END
#RESERVE_BEGIN
# All hole as well, see private.raw
image reserve.raw {
   file {
      holes = {"(0; <RESERVE_SIZE>)"}
   }
}

image reserve.sparse {
   android-sparse {
      image = reserve.raw
   }
}

#RESERVE_END
image persistent.ext4 {
   ext4 {
      use-mke2fs = true
      label = "PERSISTENT"
      extraargs = "<MKE2FS_DATA>"
   }
   mountpoint = "/persistent"
   size = <PERSISTENT_SIZE>
}
