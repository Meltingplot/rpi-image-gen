#!/bin/sh

# Create shared directories under /persistent/shared for paths declared
# by layers in /etc/rpi-image-gen/slot-shared.d/*.conf.
#
# Paths are kept one per line and always quoted, so a declared path may
# contain spaces or glob characters: "StaticPath=/data/PLA 1.2mm/load.g" must
# not become "/data/PLA" and "1.2mm/load.g", and rm -rf must only ever see
# the path as declared.
#
# RPI_SHARED_INIT_ROOT prefixes every path, for tests against a fake root.

set -eu

ROOT=${RPI_SHARED_INIT_ROOT:-}
CONF_DIR=${ROOT}/etc/rpi-image-gen/slot-shared.d
SHARED_BASE=${ROOT}/persistent/shared

nl='
'

[ -d "$CONF_DIR" ] || exit 0

# Collect from every conf first. A StaticPath may sit under another
# conf Path, so all statics must be removed before any Path is copied.
paths=""
statics=""
for conf in "${CONF_DIR}"/*.conf; do
   [ -f "$conf" ] || continue

   version=""
   cpaths=""
   cstatics=""
   while IFS= read -r line || [ -n "$line" ]; do
       case "$line" in ''|\#*) continue ;; esac
       key="${line%%=*}"
       value="${line#*=}"
       # An empty value would resolve to the whole shared tree
       [ -n "${value#/}" ] || continue
       case "$key" in
           Version)    version="$value" ;;
           Path)       cpaths="${cpaths}${nl}/${value#/}" ;;
           StaticPath) cstatics="${cstatics}${nl}/${value#/}" ;;
       esac
   done < "$conf"

   if [ "$version" != "1" ]; then
       printf 'persistent-shared-init: %s: unsupported version "%s", skipping\n' \
           "$conf" "${version:-missing}" >&2
       continue
   fi

   paths="${paths}${cpaths}"
   statics="${statics}${cstatics}"
done

# Image-owned entries are replaced from the active slot by the copy below
printf '%s\n' "$statics" | while IFS= read -r static; do
   [ -n "$static" ] || continue
   printf 'persistent-shared-init: static %s\n' "$static"
   rm -rf -- "${SHARED_BASE}${static}"
done

printf '%s\n' "$paths" | while IFS= read -r path; do
   [ -n "$path" ] || continue
   printf 'persistent-shared-init: %s\n' "$path"
   mkdir -p "${SHARED_BASE}${path}"
   # Write missing files into shared, never overwriting existing ones
   if [ -d "${ROOT}${path}" ]; then
      rsync -av --ignore-existing "${ROOT}${path}/" "${SHARED_BASE}${path}/"
   fi
done
