#!/bin/bash

set -eu

fs=$1
genimg_in=$2

[[ -d "$fs" ]] || exit 0


# Load pre-defined UUIDs
. ${genimg_in}/img_uuids


# mkfs args: UUIDs are image-structural
MKE2FS_ARGS_SYSTEM="-U $SYSTEM_UUID ${IGconf_fs_ext4_mkfs_args:-}"
MKE2FS_ARGS_DATA="${IGconf_fs_ext4_mkfs_args:-}"
EROFS_ARGS_SYSTEM="-U $SYSTEM_UUID ${IGconf_fs_erofs_mkfs_args:-}"

# verity
VERITY_ARGS_SYSTEM="\
 --data-block-size ${IGconf_linux_page_size:-4096} \
 --hash-block-size ${IGconf_linux_page_size:-4096} \
 --hash sha256 \
 --uuid ${VERITY_UUID} \
 --salt ${VERITY_SALT} \
 --root-hash-file ${IGconf_image_outputdir}/system.roothash"


# erofs is read-only: the kernel must not ask for an fsck
if [[ $IGconf_image_rootfs_type == erofs ]]; then
   mkdir -p "$LAYER_WORKDIR/for/linux-base/cmdline.d"
   echo '-fsck.repair=*' > "$LAYER_WORKDIR/for/linux-base/cmdline.d/60-fsck"
fi


# Set up the partition layout for tryboot support. Partition numbering
# relates directly to the layout in genimage.cfg.in

cat << EOF > "${fs}/bootfs/autoboot.txt"
[all]
tryboot_a_b=1
boot_partition=2
[tryboot]
boot_partition=3
EOF


# Optional private partition between the system slots and the data
# partition. Nothing mounts it: it is for one service to mount in its own
# namespace, found through /dev/disk/by-slot/<name>. The template carries it
# between #PRIVATE_BEGIN and #PRIVATE_END, which go when it is wanted and take
# the block with them when it is not.
#
# It ships with an empty ext4 filesystem, or with none (image.private_part_fs)
# so that its service formats it with the device's defaults; then it is a file
# of its size that is all hole, a hole in the disk image and "don't care" in
# the sparse image, and nothing is written to it on installation.
#
# A reserve (image.reserve_part_size) follows the private partition in the
# same way, never with a filesystem: space a later update can take to change
# the layout, which an update cannot otherwise.
private_name=${IGconf_image_private_part_name:-}
private_label=
private_image=
if [[ -n $private_name ]]; then
   case $private_name in
      bootconfig|boot_a|boot_b|system_a|system_b|persistent|reserve)
         echo "image-rota: private_part_name '$private_name' is a partition of the layout already" >&2
         exit 1 ;;
   esac
   private_label=$(echo "$private_name" | tr 'a-z' 'A-Z')
   private_filter=(-e '/^#PRIVATE_BEGIN$/d' -e '/^#PRIVATE_END$/d')
   case ${IGconf_image_private_part_fs:-ext4} in
      ext4)
         private_image=private.ext4
         private_filter+=(-e '/^#PRIVATE_EXT4_BEGIN$/d' -e '/^#PRIVATE_EXT4_END$/d'
                          -e '/^#PRIVATE_RAW_BEGIN$/,/^#PRIVATE_RAW_END$/d') ;;
      none)
         private_image=private.raw
         rm -f "${genimg_in}/private.raw"
         truncate -s "$IGconf_image_private_part_size" "${genimg_in}/private.raw"
         private_filter+=(-e '/^#PRIVATE_RAW_BEGIN$/d' -e '/^#PRIVATE_RAW_END$/d'
                          -e '/^#PRIVATE_EXT4_BEGIN$/,/^#PRIVATE_EXT4_END$/d') ;;
      *)
         echo "image-rota: private_part_fs '${IGconf_image_private_part_fs}' is neither ext4 nor none" >&2
         exit 1 ;;
   esac

   install -d "${fs}/etc/udev/rules.d"
   cat << EOF > "${fs}/etc/udev/rules.d/99-rpi-06-private.rules"
# Written by image-rota: the private partition (image.private_part_name),
# which the system does not mount.
SUBSYSTEM=="block", ENV{RPI_ONBOOTDEV}=="1", ENV{ID_PART_ENTRY_NAME}=="$private_name", SYMLINK+="disk/by-slot/$private_name"
EOF
else
   private_filter=(-e '/^#PRIVATE_BEGIN$/,/^#PRIVATE_END$/d')
fi

reserve_size=${IGconf_image_reserve_part_size:-}
if [[ -n $reserve_size ]]; then
   rm -f "${genimg_in}/reserve.raw"
   truncate -s "$reserve_size" "${genimg_in}/reserve.raw"
   reserve_filter=(-e '/^#RESERVE_BEGIN$/d' -e '/^#RESERVE_END$/d')
else
   reserve_filter=(-e '/^#RESERVE_BEGIN$/,/^#RESERVE_END$/d')
fi


# Write genimage template
cat "$LAYER_DIR/genimage.cfg.in.$IGconf_image_rootfs_type" | sed \
   "${private_filter[@]}" \
   "${reserve_filter[@]}" \
   -e "s|<PRIVATE_NAME>|$private_name|g" \
   -e "s|<PRIVATE_IMAGE>|$private_image|g" \
   -e "s|<PRIVATE_LABEL>|$private_label|g" \
   -e "s|<PRIVATE_SIZE>|${IGconf_image_private_part_size:-}|g" \
   -e "s|<IMAGE_DIR>|$IGconf_image_outputdir|g" \
   -e "s|<IMAGE_NAME>|$IGconf_image_name|g" \
   -e "s|<IMAGE_SUFFIX>|$IGconf_image_suffix|g" \
   -e "s|<BOOT_SIZE>|$IGconf_image_boot_part_size|g" \
   -e "s|<SYSTEM_SIZE>|$IGconf_image_system_part_size|g" \
   -e "s|<PERSISTENT_SIZE>|$IGconf_image_data_part_size|g" \
   -e "s|<SECTOR_SIZE>|$IGconf_device_sector_size|g" \
   -e "s|<SLOTP>|'$(readlink -ef "$LAYER_DIR/slot-post-process.sh")'|g" \
   -e "s|<BOOT_LABEL>|$BOOT_LABEL|g" \
   -e "s|<SYSTEM_UUID>|$SYSTEM_UUID|g" \
   -e "s|<MKE2FS_CONF>|'$(readlink -ef "$LAYER_DIR/mke2fs.conf")'|g" \
   -e "s|<MKE2FS_SYSTEM>|$MKE2FS_ARGS_SYSTEM|g" \
   -e "s|<MKE2FS_DATA>|$MKE2FS_ARGS_DATA|g" \
   -e "s|<EROFS_SYSTEM>|$EROFS_ARGS_SYSTEM|g" \
   -e "s|<VERITY_SYSTEM>|$VERITY_ARGS_SYSTEM|g" \
   > ${genimg_in}/genimage.cfg
